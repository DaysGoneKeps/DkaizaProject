@model DkaizaProject.Models.ReservaViewModel
@{
    ViewData["Title"] = "Reservar cita";
    Layout = "_Layout";
}

<div class="booking-page">
    <div class="booking-header">
        <div class="container">
            <p class="section-eyebrow">Nueva cita</p>
            <h1>Reserva tu servicio</h1>
        </div>
    </div>

    <div class="container booking-container">

        <!-- Step indicators -->
        <div class="steps-bar">
            <div class="step active" id="step-ind-1"><span>1</span> Fecha</div>
            <div class="step-line"></div>
            <div class="step" id="step-ind-2"><span>2</span> Estilista</div>
            <div class="step-line"></div>
            <div class="step" id="step-ind-3"><span>3</span> Horario</div>
            <div class="step-line"></div>
            <div class="step" id="step-ind-4"><span>4</span> Confirmar</div>
        </div>

        <!-- STEP 1: Fecha -->
        <div class="booking-step active" id="step-1">
            <h2 class="step-title">Seleccione una fecha</h2>
            <div class="calendar-wrap">
                <div class="cal-nav">
                    <button class="cal-prev" id="calPrev">←</button>
                    <span class="cal-month-label" id="calLabel"></span>
                    <button class="cal-next" id="calNext">→</button>
                </div>
                <div class="cal-days-header">
                    <span>Dom</span><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span>
                </div>
                <div class="cal-days" id="calDays"></div>
            </div>
        </div>

        <!-- STEP 2: Estilista -->
        <div class="booking-step" id="step-2">
            <h2 class="step-title">Elige un estilista</h2>
            <div class="stylists-grid" id="stylistsGrid">
                <div class="loading-msg">Cargando estilistas...</div>
            </div>
        </div>

        <!-- STEP 3: Horario -->
        <div class="booking-step" id="step-3">
            <h2 class="step-title">Elige un horario</h2>
            <div class="time-slots" id="timeSlots">
                <div class="loading-msg">Cargando horarios...</div>
            </div>
        </div>

        <!-- STEP 4: Confirmar -->
        <div class="booking-step" id="step-4">
            <h2 class="step-title">Confirmar reserva</h2>
            <div class="confirm-box">
                <div class="confirm-row"><span>Servicio</span><strong id="conf-servicio">—</strong></div>
                <div class="confirm-row"><span>Fecha</span><strong id="conf-fecha">—</strong></div>
                <div class="confirm-row"><span>Estilista</span><strong id="conf-estilista">—</strong></div>
                <div class="confirm-row"><span>Horario</span><strong id="conf-horario">—</strong></div>
                <div class="confirm-row"><span>Precio</span><strong id="conf-precio">—</strong></div>

                <p class="payment-method-label">Selecciona el método de pago</p>
                <button class="btn-confirm btn-pago-mp" id="btnPagarMP">Pagar con MercadoPago</button>
                <button class="btn-confirm btn-pago-efectivo" id="btnPagarEfectivo">Pagar en efectivo</button>
            </div>
        </div>

        <!-- Success -->
        <div class="booking-step" id="step-success">
            <div class="success-block">
                <div class="success-checkmark">✓</div>
                <h2 id="success-title">¡Cita reservada!</h2>
                <p id="success-resumen"></p>
                <p id="success-mensaje" class="success-mensaje"></p>
                <div class="success-actions">
                    <a href="/Appointments/MisCitas" class="btn-primary-lg">Ver mis citas</a>
                    <a href="/Appointments/Servicios" class="btn-ghost-lg">Reservar otra</a>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .selected-service-summary {
        margin-bottom: 2rem;
    }
    
    .summary-card {
        background: linear-gradient(135deg, var(--rose-light), var(--cream));
        border: 1px solid var(--rose);
        border-radius: var(--radius-lg);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }
    
    .summary-icon {
        width: 50px;
        height: 50px;
        background: var(--rose);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.3rem;
    }
    
    .summary-info {
        flex: 1;
    }
    
    .summary-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--rose-dark);
        font-weight: 600;
    }
    
    .summary-info h3 {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--ink);
        margin: 0;
    }
    
    .summary-meta {
        display: flex;
        gap: 1rem;
        margin-top: 0.25rem;
        font-size: 0.75rem;
        color: var(--ink-mid);
    }
    
    .summary-meta i {
        color: var(--rose);
        margin-right: 4px;
    }
    
    .btn-change-service {
        background: transparent;
        border: 1px solid var(--border-mid);
        padding: 8px 20px;
        border-radius: 50px;
        font-size: 0.8rem;
        color: var(--ink-mid);
        text-decoration: none;
        transition: all 0.2s;
    }
    
    .btn-change-service:hover {
        border-color: var(--rose);
        color: var(--rose);
        text-decoration: none;
    }
    
    .back-home-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: var(--ink);
        color: white;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
        z-index: 100;
        text-decoration: none;
    }
    
    .back-home-btn:hover {
        background: var(--rose-dark);
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.25);
        color: white;
    }
    
    .calendar-wrap {
        max-width: 400px;
        margin: 0 auto;
    }
    
    .cal-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }
    
    .cal-nav button {
        background: var(--cream-dark);
        border: 1px solid var(--border-mid);
        border-radius: 50%;
        width: 36px;
        height: 36px;
        cursor: pointer;
        font-size: 1rem;
        color: var(--ink-mid);
        transition: all 0.2s;
    }
    
    .cal-nav button:hover {
        background: var(--rose-light);
        border-color: var(--rose);
        color: var(--rose);
    }
    
    .cal-month-label {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--ink);
    }
    
    .cal-days-header {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
        margin-bottom: 8px;
    }
    
    .cal-days-header span {
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        color: var(--ink-mid);
        padding: 8px 0;
    }
    
    .cal-days {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
    }
    
    .cal-cell {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: var(--white);
        border: 1px solid transparent;
    }
    
    .cal-cell:hover:not(.disabled):not(.empty) {
        background: var(--rose-light);
        border-color: var(--rose);
        transform: scale(1.05);
    }
    
    .cal-cell.selected {
        background: var(--ink);
        color: white;
    }
    
    .cal-cell.disabled {
        color: var(--border-mid);
        cursor: not-allowed;
        background: var(--cream-dark);
    }
    
    .cal-cell.empty {
        cursor: default;
        background: transparent;
    }
    
    .step-title {
        text-align: center;
        margin-bottom: 1.5rem;
        font-family: var(--font-display);
        font-size: 1.3rem;
    }
    
    /* Confirmar reserva - CENTRADO */
    .confirm-box {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 2rem;
        max-width: 480px;
        width: 100%;
        margin: 0 auto;
    }
    
    .confirm-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding: 10px 0;
        border-bottom: 1px solid var(--border);
        font-size: 14px;
    }
    
    .confirm-row:last-of-type {
        border-bottom: none;
    }
    
    .confirm-row span {
        color: var(--ink-light);
    }
    
    .confirm-row strong {
        color: var(--ink);
    }
    
    .btn-confirm {
        display: block;
        width: 100%;
        background: var(--ink);
        color: var(--white);
        border: none;
        border-radius: 50px;
        padding: 14px;
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        font-family: var(--font-body);
        margin-top: 1.5rem;
        transition: background 0.2s;
    }
    
    .btn-confirm:hover {
        background: var(--rose-dark);
    }
    
    .btn-confirm:disabled {
        background: var(--border-mid);
        cursor: not-allowed;
    }

    .payment-method-label {
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        font-size: 13px;
        color: var(--ink-light);
        text-align: center;
        letter-spacing: 0.5px;
    }

    .btn-pago-mp {
        margin-top: 0;
    }

    .btn-pago-efectivo {
        margin-top: 0.75rem;
        background: var(--white);
        color: var(--ink);
        border: 1px solid var(--border-mid);
    }

    .btn-pago-efectivo:hover {
        background: var(--cream-dark);
        border-color: var(--ink);
    }

    .success-mensaje {
        font-size: 14px;
        color: var(--ink-mid);
        margin-top: 0.5rem;
    }

    @@media (max-width: 768px) {
        .back-home-btn {
            bottom: 20px;
            right: 20px;
            width: 45px;
            height: 45px;
        }
        .calendar-wrap {
            max-width: 320px;
        }
        .cal-cell {
            font-size: 12px;
        }
        .cal-days-header span {
            font-size: 10px;
        }
        .confirm-box {
            margin: 0 auto;
            padding: 1.5rem;
        }
    }
</style>

<a href="/" class="back-home-btn" title="Volver al inicio">
    <i class="fas fa-home"></i>
</a>

@section Scripts {
<script>
const MONTHS = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const DIAS_LONG = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];

let sel = { 
    servicio: null, 
    fecha: null, 
    estilista: null, 
    horario: null 
};
let calYear = new Date().getFullYear();
let calMonth = new Date().getMonth();

const urlParams = new URLSearchParams(window.location.search);
const servicioId = urlParams.get('servicioId');

// ── Cargar servicio seleccionado ─────────────────────────────────────────
async function loadSelectedService() {
    if (!servicioId) {
        window.location.href = '/Appointments/Servicios';
        return;
    }
    
    const servicios = @Html.Raw(Json.Serialize(Model.Servicios));
    const servicio = servicios.find(s => s.id == servicioId);
    
    if (servicio) {
        sel.servicio = {
            id: servicio.id,
            dur: servicio.duracionHoras,
            nombre: servicio.nombre,
            precio: servicio.precio
        };
    } else {
        window.location.href = '/Appointments/Servicios';
    }
}

// ── Step navigation ──────────────────────────────────────────────────────
function showStep(n) {
    document.querySelectorAll('.booking-step').forEach(s => s.classList.remove('active'));
    document.getElementById('step-' + n).classList.add('active');
    document.querySelectorAll('.step').forEach((s, i) => {
        const stepNum = i + 1;
        s.classList.toggle('active', stepNum === n);
        s.classList.toggle('done', stepNum < n);
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ── Calendar ─────────────────────────────────────────────────────────────
function renderCalendar() {
    const label = document.getElementById('calLabel');
    const grid = document.getElementById('calDays');
    label.textContent = MONTHS[calMonth] + ' ' + calYear;
    const firstDay = new Date(calYear, calMonth, 1).getDay();
    const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
    const today = new Date(); today.setHours(0,0,0,0);
    let html = '';
    for (let i = 0; i < firstDay; i++) html += '<div class="cal-cell empty"></div>';
    for (let d = 1; d <= daysInMonth; d++) {
        const date = new Date(calYear, calMonth, d);
        const dow = date.getDay();
        const isPast = date < today;
        const isDom = dow === 0;
        const isSel = sel.fecha && sel.fecha.d === d && sel.fecha.m === calMonth && sel.fecha.y === calYear;
        let cls = 'cal-cell';
        if (isPast || isDom) cls += ' disabled';
        else if (isSel) cls += ' selected';
        html += `<div class="${cls}" data-d="${d}" data-m="${calMonth}" data-y="${calYear}">${d}</div>`;
    }
    grid.innerHTML = html;
    grid.querySelectorAll('.cal-cell:not(.disabled):not(.empty)').forEach(cell => {
        cell.addEventListener('click', () => {
            sel.fecha = { d: +cell.dataset.d, m: +cell.dataset.m, y: +cell.dataset.y };
            sel.estilista = null; sel.horario = null;
            renderCalendar();
            loadEstilistas();
            showStep(2);
        });
    });
}

document.getElementById('calPrev').onclick = () => {
    calMonth--; if (calMonth < 0) { calMonth = 11; calYear--; }
    renderCalendar();
};
document.getElementById('calNext').onclick = () => {
    calMonth++; if (calMonth > 11) { calMonth = 0; calYear++; }
    renderCalendar();
};

// ── Step 2: Estilistas ───────────────────────────────────────────────────
async function loadEstilistas() {
    const grid = document.getElementById('stylistsGrid');
    grid.innerHTML = '<div class="loading-msg">Cargando estilistas...</div>';
    const f = sel.fecha;
    const fechaStr = `${f.y}-${String(f.m+1).padStart(2,'0')}-${String(f.d).padStart(2,'0')}`;
    const res = await fetch(`/Appointments/EstilistasDisponibles?servicioId=${sel.servicio.id}&fecha=${fechaStr}`);
    const data = await res.json();
    let html = '';
    data.forEach(e => {
        const free = e.horariosLibres;
        let fotoHtml = '';
        if (e.fotoBase64) {
            fotoHtml = `<img src="data:${e.fotoContentType};base64,${e.fotoBase64}" class="stylist-avatar" style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover;">`;
        } else {
            fotoHtml = `<div class="stylist-avatar">${e.nombre.charAt(0)}</div>`;
        }
        
        html += `<div class="stylist-card ${free===0?'no-slots':''}" data-id="${e.estilistaId}" data-nombre="${e.nombre}">
            ${fotoHtml}
            <div class="stylist-info">
                <h3>${e.nombre}</h3>
                <p>${e.especialidad || 'Estilista profesional'}</p>
                <small>🕐 ${e.horario} · descanso ${e.descanso}</small>
            </div>
            <div class="stylist-slots ${free>0?'slots-ok':'slots-none'}">${free} libre${free!==1?'s':''}</div>
        </div>`;
    });
    grid.innerHTML = html || '<p>No hay estilistas disponibles.</p>';
    grid.querySelectorAll('.stylist-card:not(.no-slots)').forEach(card => {
        card.addEventListener('click', () => {
            grid.querySelectorAll('.stylist-card').forEach(c => c.classList.remove('selected'));
            card.classList.add('selected');
            sel.estilista = { id: +card.dataset.id, nombre: card.dataset.nombre };
            sel.horario = null;
            loadHorarios();
            showStep(3);
        });
    });
}

// ── Step 3: Horarios ─────────────────────────────────────────────────────
async function loadHorarios() {
    const wrap = document.getElementById('timeSlots');
    wrap.innerHTML = '<div class="loading-msg">Cargando horarios...</div>';
    const f = sel.fecha;
    const fechaStr = `${f.y}-${String(f.m+1).padStart(2,'0')}-${String(f.d).padStart(2,'0')}`;
    const res = await fetch(`/Appointments/HorariosDisponibles?servicioId=${sel.servicio.id}&estilistaId=${sel.estilista.id}&fecha=${fechaStr}`);
    const slots = await res.json();
    if (!slots.length) { wrap.innerHTML = '<p>No hay horarios disponibles.</p>'; return; }
    let html = '<div class="slots-grid">';
    slots.forEach(s => {
        html += `<button class="slot-btn ${s.disponible?'':'blocked'}" data-start="${s.horaInicio}" data-end="${s.horaFin}" data-label="${s.label}" ${s.disponible?'':' disabled'}>${s.label}</button>`;
    });
    html += '</div>';
    wrap.innerHTML = html;
    wrap.querySelectorAll('.slot-btn:not(.blocked)').forEach(btn => {
        btn.addEventListener('click', () => {
            wrap.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            sel.horario = { start: +btn.dataset.start, end: +btn.dataset.end, label: btn.dataset.label };
            fillConfirm();
            showStep(4);
        });
    });
}

// ── Step 4: Confirmar ────────────────────────────────────────────────────
function fillConfirm() {
    const f = sel.fecha;
    const date = new Date(f.y, f.m, f.d);
    document.getElementById('conf-servicio').textContent = sel.servicio.nombre;
    document.getElementById('conf-fecha').textContent = `${DIAS_LONG[date.getDay()]} ${f.d} de ${MONTHS[f.m]}`;
    document.getElementById('conf-estilista').textContent = sel.estilista.nombre;
    document.getElementById('conf-horario').textContent = sel.horario.label;
    document.getElementById('conf-precio').textContent = 'S/ ' + sel.servicio.precio;
}

// ── Confirmar reserva ─────────────────────────────────────────────────────
function buildReservaBody(metodoPago) {
    const f = sel.fecha;
    const fechaStr = `${f.y}-${String(f.m+1).padStart(2,'0')}-${String(f.d).padStart(2,'0')}`;
    return {
        servicioId: sel.servicio.id,
        estilistaId: sel.estilista.id,
        fecha: fechaStr,
        horaInicio: sel.horario.start,
        notas: '',
        metodoPago: metodoPago
    };
}

function buildResumenTexto() {
    const f = sel.fecha;
    const date = new Date(f.y, f.m, f.d);
    return `${sel.servicio.nombre} con ${sel.estilista.nombre} el ${DIAS_LONG[date.getDay()]} ${f.d} de ${MONTHS[f.m]} · ${sel.horario.label}`;
}

async function enviarReserva(btn, metodoPago, etiquetaProcesando, etiquetaOriginal) {
    const btnMP = document.getElementById('btnPagarMP');
    const btnEf = document.getElementById('btnPagarEfectivo');
    btnMP.disabled = true; btnEf.disabled = true;
    btn.textContent = etiquetaProcesando;
    const body = buildReservaBody(metodoPago);
    let data;
    try {
        const res = await fetch('/Appointments/Crear', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        data = await res.json();
    } catch (err) {
        alert('Error de red. Intenta nuevamente.');
        btnMP.disabled = false; btnEf.disabled = false;
        btn.textContent = etiquetaOriginal;
        return;
    }

    if (data.success && data.redirectUrl) {
        sessionStorage.removeItem('reservaPendiente');
        window.location.href = data.redirectUrl;
        return;
    }
    if (data.success && data.metodoPago === 'efectivo') {
        sessionStorage.removeItem('reservaPendiente');
        document.getElementById('success-title').textContent = '¡Cita reservada!';
        document.getElementById('success-resumen').textContent = buildResumenTexto();
        document.getElementById('success-mensaje').textContent = data.mensaje || 'Reserva realizada, realice el pago al asistir';
        showStep('success');
        return;
    }
    if (data.requiresLogin) {
        sessionStorage.setItem('reservaPendiente', JSON.stringify(body));
        window.location.href = '/Account/Login?returnUrl=/Appointments/Reservar?servicioId=' + sel.servicio.id;
        return;
    }
    alert(data.message || 'Error al reservar.');
    btnMP.disabled = false; btnEf.disabled = false;
    btn.textContent = etiquetaOriginal;
}

document.getElementById('btnPagarMP').addEventListener('click', function () {
    enviarReserva(this, 'mercadopago', 'Procesando...', 'Pagar con MercadoPago');
});

document.getElementById('btnPagarEfectivo').addEventListener('click', function () {
    enviarReserva(this, 'efectivo', 'Procesando...', 'Pagar en efectivo (al asistir)');
});

window.addEventListener('pageshow', function (e) {
    const btnMP = document.getElementById('btnPagarMP');
    if (e.persisted && btnMP && btnMP.textContent.trim() === 'Procesando...') {
        window.location.href = '/Payment/Success';
    }
});

// ── Reanudar reserva pendiente ───────────────────────────────────────────
async function resumePendingReserva() {
    const raw = sessionStorage.getItem('reservaPendiente');
    if (!raw) return;
    let body;
    try { body = JSON.parse(raw); } catch { sessionStorage.removeItem('reservaPendiente'); return; }
    if (!body || String(body.servicioId) !== String(servicioId)) return;

    const [y, m, d] = body.fecha.split('-').map(n => parseInt(n, 10));
    sel.fecha = { d, m: m - 1, y };
    calYear = y; calMonth = m - 1;
    renderCalendar();

    await loadEstilistas();
    const card = document.querySelector(`.stylist-card[data-id="${body.estilistaId}"]`);
    if (!card) { showStep(2); return; }
    document.querySelectorAll('.stylist-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    sel.estilista = { id: body.estilistaId, nombre: card.dataset.nombre };

    await loadHorarios();
    const slot = document.querySelector(`.slot-btn[data-start="${body.horaInicio}"]:not(.blocked)`);
    if (!slot) { showStep(3); return; }
    document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('selected'));
    slot.classList.add('selected');
    sel.horario = { start: +slot.dataset.start, end: +slot.dataset.end, label: slot.dataset.label };

    // Ya no hay notas
    fillConfirm();
    showStep(4);
}


// Inicializar
renderCalendar();
loadSelectedService().then(() => resumePendingReserva());
</script>
}