@model List<DkaizaProject.Models.Notificacion>
@{
    ViewData["Title"] = "Notificaciones";
    Layout = "_Layout";
    var pendientes = Model.Where(n => !n.Procesada).ToList();
}

@* ── SVG helpers reutilizables ── *@
@{
    string IcoCalendario = @"<svg class=""ni-main"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""1.6"" stroke-linecap=""round"" stroke-linejoin=""round"" aria-hidden=""true""><rect x=""3"" y=""4"" width=""18"" height=""18"" rx=""2""/><path d=""M16 2v4M8 2v4M3 10h18""/><circle cx=""12"" cy=""16"" r=""1.5"" fill=""currentColor""/></svg>";

    string IcoServicio = @"<svg class=""ni-sm"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""1.8"" stroke-linecap=""round"" stroke-linejoin=""round"" aria-hidden=""true""><path d=""M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17a1 1 0 001 1h6a1 1 0 001-1v-2.26C17.81 13.47 19 11.38 19 9c0-3.87-3.13-7-7-7z""/><path d=""M9 21h6M10 17v4M14 17v4""/></svg>";

    string IcoEstilista = @"<svg class=""ni-sm"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""1.8"" stroke-linecap=""round"" stroke-linejoin=""round"" aria-hidden=""true""><path d=""M20 7c0 2.21-3.58 4-8 4S4 9.21 4 7s3.58-4 8-4 8 1.79 8 4z""/><path d=""M4 7v5c0 2.21 3.58 4 8 4s8-1.79 8-4V7""/><path d=""M4 12v5c0 2.21 3.58 4 8 4s8-1.79 8-4v-5""/></svg>";

    string IcoFecha = @"<svg class=""ni-sm"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""1.8"" stroke-linecap=""round"" stroke-linejoin=""round"" aria-hidden=""true""><rect x=""3"" y=""4"" width=""18"" height=""18"" rx=""2""/><path d=""M16 2v4M8 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01""/></svg>";

    string IcoHora = @"<svg class=""ni-sm"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""1.8"" stroke-linecap=""round"" stroke-linejoin=""round"" aria-hidden=""true""><circle cx=""12"" cy=""12"" r=""9""/><path d=""M12 7v5l3 3""/></svg>";


    string IcoBell = @"<svg style=""width:48px;height:48px;"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""1.4"" stroke-linecap=""round"" stroke-linejoin=""round"" aria-hidden=""true""><path d=""M6 10a6 6 0 0112 0c0 4 2 6 2 6H4s2-2 2-6""/><path d=""M13.73 21a2 2 0 01-3.46 0""/></svg>";
}

<div class="notif-page">
    <div class="container">
        <div class="notif-page-header">
            <div>
                <p class="section-eyebrow">Mi cuenta</p>
                <h1>Notificaciones</h1>
            </div>
            <span class="notif-count-badge">@pendientes.Count pendiente(s)</span>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state" style="margin-top:3rem;">
                <div class="empty-icon" style="color:var(--rose);">
                    @Html.Raw(IcoBell)
                </div>
                <h3>Sin notificaciones</h3>
                <p>Cuando tengas una cita próxima te avisaremos aquí.</p>
            </div>
        }
        else
        {
            @if (pendientes.Any())
            {
                <h2 class="notif-section-title">Pendientes de acción</h2>
                <div class="notif-list">
                    @foreach (var n in pendientes)
                    {
                        <div class="notif-card notif-card--pendiente" id="ncard-@n.Id">

                            <div class="notif-card__icon">
                                @Html.Raw(IcoCalendario)
                            </div>

                            <div class="notif-card__body">
                                <h3>@n.Titulo</h3>
                                <p>@Html.Raw(n.Mensaje)</p>
                                <div class="notif-cita-detalle">
                                    <span>
                                        @Html.Raw(IcoServicio)
                                        @n.Cita.Servicio.Nombre
                                    </span>
                                    <span>
                                        @Html.Raw(IcoEstilista)
                                        @n.Cita.Estilista.Nombre
                                    </span>
                                    <span>
                                        @Html.Raw(IcoFecha)
                                        @n.Cita.Fecha.ToString("dd/MM/yyyy")
                                    </span>
                                    <span>
                                        @Html.Raw(IcoHora)
                                        @($"{n.Cita.HoraInicio:D2}:00") – @($"{n.Cita.HoraFin:D2}:00")
                                    </span>
                                </div>
                                <span class="notif-fecha">@n.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                            <div class="notif-card__actions">
                                <button class="btn-confirmar-notif" data-id="@n.Id">
                                    Confirmar Asistencia
                                </button>

                                <button class="btn-cancelar-notif" data-id="@n.Id">
                                    Cancelar cita
                                </button>
                            </div>

                        </div>
                    }
                </div>
            }


        }
    </div>
</div>

@section Styles {
<style>
/* ── Página ── */
.notif-page { padding: 2rem 0 4rem; min-height: calc(100vh - 200px); }

.notif-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
}

.notif-count-badge {
    background: var(--rose-light);
    color: var(--rose-dark);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: 50px;
    border: 1px solid var(--rose);
}

.notif-section-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--ink-mid);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
}

/* ── Lista ── */
.notif-list { display: flex; flex-direction: column; gap: 1rem; }

.notif-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    transition: box-shadow 0.2s;
}

.notif-card--pendiente {
    border-left: 4px solid var(--rose);
    box-shadow: 0 2px 12px rgba(200,169,138,0.12);
}


/* ── Ícono principal (tarjeta pendiente) ── */
.notif-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    min-width: 2.6rem;
    background: var(--rose-light);
    border-radius: 12px;
    color: var(--rose-dark);
    flex-shrink: 0;
}

.ni-main {
    width: 22px;
    height: 22px;
}

/* ── Body de la tarjeta ── */
.notif-card__body { flex: 1; }
.notif-card__body h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--ink); }
.notif-card__body p  { font-size: 0.85rem; color: var(--ink-mid); margin-bottom: 0.75rem; }

/* ── Detalle de cita ── */
.notif-cita-detalle {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: 0.8rem;
    color: var(--ink-mid);
    margin-bottom: 0.5rem;
    background: var(--cream);
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
}

.notif-cita-detalle span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
}

/* Íconos pequeños dentro del detalle */
.ni-sm {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: var(--rose-dark);
    opacity: 0.8;
}

.notif-fecha { font-size: 0.75rem; color: var(--ink-light); }

/* ── Acciones ── */
.notif-card__actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-shrink: 0;
}

.btn-confirmar-notif,
.btn-cancelar-notif {
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    border: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s;
    white-space: nowrap;
    line-height: 1;
}

.btn-confirmar-notif {
    background: var(--ink);
    color: white;
}
.btn-confirmar-notif:hover { background: var(--rose-dark); }

.btn-cancelar-notif {
    background: transparent;
    border: 1px solid #e0b4b4;
    color: #b83232;
}
.btn-cancelar-notif:hover { background: #fdf0f0; }

/* ── Responsive ── */
@@media (max-width: 640px) {
    .notif-card { flex-direction: column; }
    .notif-card__actions { flex-direction: row; flex-wrap: wrap; }
}
</style>
}

@section Scripts {
<script>
async function accionNotif(id, accion) {
    const url = `/Notificaciones/${accion}/${id}`;
    const res = await fetch(url, { method: 'POST' });
    const data = await res.json();
    if (data.success) {
        const card = document.getElementById('ncard-' + id);
        card.style.transition = 'opacity 0.4s';
        card.style.opacity = '0';
        setTimeout(() => { card.remove(); location.reload(); }, 400);
    } else {
        alert(data.message || 'Error al procesar');
    }
}

document.querySelectorAll('.btn-confirmar-notif').forEach(btn =>
    btn.addEventListener('click', () => {
        if (confirm('¿Confirmas tu asistencia a la cita?'))
            accionNotif(btn.dataset.id, 'Confirmar');
    }));

document.querySelectorAll('.btn-cancelar-notif').forEach(btn =>
    btn.addEventListener('click', () => {
        if (confirm('¿Seguro que deseas cancelar esta cita? El horario quedará libre.'))
            accionNotif(btn.dataset.id, 'Cancelar');
    }));
</script>
}
