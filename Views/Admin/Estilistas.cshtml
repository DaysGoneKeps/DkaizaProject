@model List<DkaizaProject.Models.Estilista>
@{
    ViewData["Title"] = "Gestión de Estilistas";
    Layout = "_Layout";
}

<style>
    .admin-page { padding: 2rem 0 4rem; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
    .page-header h1 { font-family: var(--font-display); font-size: 1.8rem; color: var(--ink); margin: 0; }
    .section-eyebrow { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--rose); margin-bottom: 0.25rem; }
    
    .btn-primary-lg {
        background: var(--ink);
        color: white;
        border: none;
        border-radius: 50px;
        padding: 10px 24px;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }
    .btn-primary-lg:hover { background: var(--rose-dark); transform: translateY(-2px); }
    
    /* Grilla de 3 columnas moderna */
    .stylists-admin-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-top: 1rem;
    }
    
    /* Tarjeta compacta y ordenada */
    .stylist-admin-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }
    
    .stylist-admin-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
        border-color: var(--rose);
    }
    
    /* Cabecera de la tarjeta con foto y nombre */
    .card-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }
    
    .stylist-foto {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        object-fit: cover;
        background: var(--cream-dark);
        border: 3px solid var(--rose-light);
    }
    
    .stylist-foto-placeholder {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--rose-light), var(--cream-dark));
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--rose-dark);
        font-size: 1.8rem;
        border: 3px solid var(--rose-light);
    }
    
    .card-title {
        flex: 1;
        min-width: 0;
    }
    
    .card-title h3 {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--ink);
        margin: 0 0 0.2rem 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .estado-badge-card {
        display: inline-block;
        font-size: 0.65rem;
        padding: 3px 10px;
        border-radius: 50px;
        font-weight: 500;
    }
    .estado-activo-card { background: #eafaf1; color: #1a7a4a; }
    .estado-inactivo-card { background: #fdf0f0; color: #b83232; }
    
    /* Especialidad */
    .especialidad-text {
        font-size: 0.75rem;
        color: var(--rose-dark);
        font-weight: 500;
        margin-bottom: 0.75rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    /* Información de horarios en formato grid compacto */
    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.6rem;
        margin-bottom: 1rem;
        padding: 0.75rem 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }
    
    .info-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.7rem;
        color: var(--ink-mid);
    }
    
    .info-item i {
        width: 20px;
        color: var(--rose);
        font-size: 0.7rem;
    }
    
    .info-item span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    /* Horario de descanso más compacto */
    .break-info {
        background: var(--cream-dark);
        border-radius: var(--radius-sm);
        padding: 0.5rem 0.75rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.7rem;
        color: var(--ink-mid);
    }
    
    .break-info i {
        color: var(--rose-dark);
    }
    
    /* Acciones alineadas y ordenadas */
    .stylist-admin-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 0.5rem;
        padding-top: 0.5rem;
    }
    
    .btn-edit, .btn-delete {
        border-radius: 50px;
        padding: 5px 14px;
        font-size: 0.7rem;
        cursor: pointer;
        transition: all 0.2s;
        font-family: var(--font-body);
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    
    .btn-edit {
        background: none;
        border: 1px solid var(--border-mid);
        color: var(--ink-mid);
    }
    .btn-edit:hover { background: var(--cream-dark); border-color: var(--rose); color: var(--ink); }
    
    .btn-delete {
        background: none;
        border: 1px solid #f5c6c6;
        color: #b83232;
    }
    .btn-delete:hover { background: #fdf0f0; }
    
    /* Responsive */
    @@media (max-width: 1024px) {
        .stylists-admin-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    
    @@media (max-width: 640px) {
        .stylists-admin-grid {
            grid-template-columns: 1fr;
        }
    }
    
    /* Alertas */
    .alert-success { background: #eafaf1; color: #1a7a4a; padding: 12px 16px; border-radius: 8px; margin-bottom: 1.5rem; border-left: 4px solid #1a7a4a; }
    .alert-error { background: #fdf0f0; color: #b83232; padding: 12px 16px; border-radius: 8px; margin-bottom: 1.5rem; border-left: 4px solid #b83232; }
    
    /* Modal - MISMO ESTILO QUE SERVICIOS */
    .modal-simple {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
        z-index: 10000;
        backdrop-filter: blur(4px);
    }
    
    .modal-simple-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: white;
        border-radius: 20px;
        width: 90%;
        max-width: 550px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 25px 50px rgba(0,0,0,0.3);
        animation: modalFadeIn 0.3s ease;
    }
    
    @@keyframes modalFadeIn {
        from { opacity: 0; transform: translate(-50%, -48%); }
        to { opacity: 1; transform: translate(-50%, -50%); }
    }
    
    .modal-simple-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.75rem;
        border-bottom: 1px solid var(--border);
        background: linear-gradient(135deg, var(--rose-light) 0%, var(--cream) 100%);
        border-radius: 20px 20px 0 0;
    }
    
    .modal-simple-header h3 {
        margin: 0;
        font-family: var(--font-display);
        font-size: 1.3rem;
        color: var(--ink);
    }
    
    .modal-simple-header h3 i {
        margin-right: 8px;
        color: var(--rose-dark);
    }
    
    .modal-simple-header button {
        background: rgba(0,0,0,0.1);
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        font-size: 1.2rem;
        cursor: pointer;
        color: var(--ink-mid);
        transition: all 0.2s;
    }
    
    .modal-simple-header button:hover {
        background: var(--rose);
        color: white;
        transform: rotate(90deg);
    }
    
    .modal-simple-body {
        padding: 1.75rem;
    }
    
    .form-group {
        margin-bottom: 1.25rem;
    }
    
    .form-group label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--ink-mid);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .form-group label i {
        margin-right: 6px;
        color: var(--rose);
    }
    
    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid var(--border-mid);
        border-radius: 12px;
        font-size: 0.85rem;
        font-family: var(--font-body);
        transition: all 0.2s;
        background: var(--cream);
    }
    
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: var(--rose);
        background: white;
        box-shadow: 0 0 0 3px rgba(200, 169, 138, 0.2);
    }
    
    .row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }
    
    .image-upload-area {
        border: 2px dashed var(--border-mid);
        border-radius: 16px;
        padding: 1.5rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        background: var(--cream);
    }
    
    .image-upload-area:hover {
        border-color: var(--rose);
        background: var(--rose-light);
    }
    
    .image-upload-icon {
        font-size: 2rem;
        color: var(--rose-dark);
        margin-bottom: 0.5rem;
    }
    
    .image-upload-text {
        font-size: 0.8rem;
        color: var(--ink-mid);
    }
    
    .image-upload-hint {
        font-size: 0.65rem;
        color: var(--ink-light);
    }
    
    .image-preview {
    margin-top: 1rem;
    text-align: center;
    position: relative;
}

.image-preview img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--rose);
}

.remove-image {
    position: absolute;
    top: -8px;
    right: calc(50% - 40px);
    background: #b83232;
    color: white;
    border: none;
    border-radius: 50%;
    width: 22px;
    height: 22px;
    cursor: pointer;
    font-size: 11px;
}

.remove-image:hover {
    background: #8b1a1a;
    transform: scale(1.1);
}
    
    .radio-group {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        flex-wrap: wrap;
    }
    
    .radio-group label {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        text-transform: none;
        font-weight: normal;
    }
    
    .radio-group input[type="radio"] {
        width: auto;
        margin: 0;
    }
    
    .estado-info {
        background: var(--cream-dark);
        border-radius: 12px;
        padding: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .btn-submit {
        width: 100%;
        background: var(--ink);
        color: white;
        border: none;
        border-radius: 50px;
        padding: 12px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        margin-top: 1rem;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    
    .btn-submit:hover {
        background: var(--rose-dark);
        transform: translateY(-2px);
    }
</style>

<div class="admin-page">
    <div class="container">
        <div class="page-header">
            <div>
                <p class="section-eyebrow">Administración</p>
                <h1>Lista de Estilistas</h1>
            </div>
            <button class="btn-primary-lg" onclick="mostrarModalNuevo()">
                <i class="fas fa-plus"></i> Añadir estilista
            </button>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
        }
        
        @if (TempData["Error"] != null)
        {
            <div class="alert-error"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
        }

        <div class="stylists-admin-grid">
            @foreach (var e in Model)
            {
                <div class="stylist-admin-card">
                    <div class="card-header">
                        @if (e.FotoBytes != null && e.FotoBytes.Length > 0)
                        {
                            <img src="data:@e.FotoContentType;base64,@Convert.ToBase64String(e.FotoBytes)" class="stylist-foto" />
                        }
                        else
                        {
                            <div class="stylist-foto-placeholder">
                                <i class="fas fa-user"></i>
                            </div>
                        }
                        <div class="card-title">
                            <h3>@e.Nombre</h3>
                            <div class="especialidad-text">
                            <i class="fas fa-star"></i> @e.Especialidad
                        </div>
                        </div>
                    </div>
                    
                 
                    
                    <div class="info-grid">
                        <div class="info-item">
                            <i class="far fa-clock"></i>
                            <span>@e.HorarioTexto</span>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-coffee"></i>
                            <span>@e.DescansoTexto</span>
                        </div>
                    </div>
                    
                    <div class="break-info">
                        <i class="fas fa-utensils"></i>
                        <span>Descanso: @e.HoraInicioDescanso:00 - @e.HoraFinDescanso:00</span>
                    </div>
                    
                    <div class="stylist-admin-actions">
                        <!--  
                        <button class="btn-edit" onclick="mostrarModalEditar(@e.Id)"><i class="fas fa-edit"></i> Editar</button>-->
                        <button class="btn-delete" onclick="eliminarEstilista(@e.Id, '@e.Nombre')"><i class="fas fa-trash"></i> Eliminar</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@{
    var horas = Enumerable.Range(6, 18).ToList();
}

<!-- Modal Nuevo Estilista -->
<div id="modalNuevo" class="modal-simple">
    <div class="modal-simple-content">
        <div class="modal-simple-header">
            <h3><i class="fas fa-plus-circle"></i> Registro de estilista</h3>
            <button onclick="cerrarModalNuevo()">✕</button>
        </div>
        <div class="modal-simple-body">
            <form id="formNuevo" asp-action="CrearEstilista" asp-controller="Admin" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                <div class="form-group">
                    <label><i class="fas fa-user"></i> Nombre *</label>
                    <input type="text" name="Nombre" required placeholder="Ej: María González" />
                    
                </div>
                
                <div class="form-group">
                    <label><i class="fas fa-star"></i> Especialidad</label>
                    <input type="text" name="Especialidad" placeholder="Ej: Coloración y Balayage" />
                </div>
                
                <div class="row-2">
                    <div class="form-group">
                        <label><i class="far fa-clock"></i> Inicio trabajo</label>
                        <select name="HoraInicioTrabajo">
                            @foreach (var h in horas) { <option value="@h" selected="@(h == 10 ? "selected" : null)">@h:00</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label><i class="far fa-clock"></i> Fin trabajo</label>
                        <select name="HoraFinTrabajo">
                            @foreach (var h in horas) { <option value="@h" selected="@(h == 22 ? "selected" : null)">@h:00</option> }
                        </select>
                    </div>
                </div>
                
                <div class="row-2">
                    <div class="form-group">
                        <label><i class="fas fa-coffee"></i> Inicio descanso</label>
                        <select name="HoraInicioDescanso">
                            @foreach (var h in horas) { <option value="@h" selected="@(h == 13 ? "selected" : null)">@h:00</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-coffee"></i> Fin descanso</label>
                        <select name="HoraFinDescanso">
                            @foreach (var h in horas) { <option value="@h" selected="@(h == 14 ? "selected" : null)">@h:00</option> }
                        </select>
                    </div>
                </div>
                
                <!-- Área de subida de foto -->
                <div class="form-group">
                    <label><i class="fas fa-camera"></i> Foto del estilista</label>
                    <div class="image-upload-area" id="uploadAreaNuevo" onclick="document.getElementById('fotoInputNuevo').click()">
                        <i class="fas fa-cloud-upload-alt image-upload-icon"></i>
                        <div class="image-upload-text">Adjuntar Foto</div>
                        <div class="image-upload-hint">PNG o JPG (máx 2MB)</div>
                    </div>
                    <input type="file" name="Foto" id="fotoInputNuevo" accept="image/*" style="display: none;" onchange="previewFotoNuevo(this)" />
                    <div id="previewContainerNuevo" class="image-preview" style="display: none;">
                        <img id="previewFotoNuevo" src="" alt="Vista previa" />
                        <button type="button" class="remove-image" onclick="removerFotoNuevo()">✕</button>
                    </div>
                </div>
                
                <!-- Estado: Siempre activo al crear -->
                <div class="form-group">
                    <label><i class="fas fa-toggle-on"></i> Estado</label>
                    <div class="estado-info">
                        <i class="fas fa-check-circle"></i>
                        <span>El estilista se creará como <strong>Activo</strong></span>
                    </div>
                    <input type="hidden" name="Activo" value="true" />
                </div>
                
                <button type="submit" class="btn-submit">
                    <i class="fas fa-save"></i> Guardar
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar Estilista -->
<div id="modalEditar" class="modal-simple">
    <div class="modal-simple-content">
        <div class="modal-simple-header">
            <h3><i class="fas fa-edit"></i> Editar estilista</h3>
            <button onclick="cerrarModalEditar()">✕</button>
        </div>
        <div class="modal-simple-body">
            <form id="formEditar" asp-action="EditarEstilista" asp-controller="Admin" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                
                <div class="form-group">
                    <label><i class="fas fa-user"></i> Nombre *</label>
                    <input type="text" name="Nombre" id="editNombre" required />
                </div>
                
                <div class="form-group">
                    <label><i class="fas fa-star"></i> Especialidad</label>
                    <input type="text" name="Especialidad" id="editEspecialidad" />
                </div>
                
                <div class="row-2">
                    <div class="form-group">
                        <label><i class="far fa-clock"></i> Inicio trabajo</label>
                        <select name="HoraInicioTrabajo" id="editInicioTrabajo">
                            @foreach (var h in horas) { <option value="@h">@h:00</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label><i class="far fa-clock"></i> Fin trabajo</label>
                        <select name="HoraFinTrabajo" id="editFinTrabajo">
                            @foreach (var h in horas) { <option value="@h">@h:00</option> }
                        </select>
                    </div>
                </div>
                
                <div class="row-2">
                    <div class="form-group">
                        <label><i class="fas fa-coffee"></i> Inicio descanso</label>
                        <select name="HoraInicioDescanso" id="editInicioDescanso">
                            @foreach (var h in horas) { <option value="@h">@h:00</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-coffee"></i> Fin descanso</label>
                        <select name="HoraFinDescanso" id="editFinDescanso">
                            @foreach (var h in horas) { <option value="@h">@h:00</option> }
                        </select>
                    </div>
                </div>
                
                <!-- Área de cambio de foto -->
                <div class="form-group">
                    <label><i class="fas fa-camera"></i> Cambiar foto</label>
                    <div class="image-upload-area" id="uploadAreaEditar" onclick="document.getElementById('fotoInputEditar').click()">
                        <i class="fas fa-cloud-upload-alt image-upload-icon"></i>
                        <div class="image-upload-text">Cambiar Foto</div>
                        <div class="image-upload-hint">PNG o JPG (máx 2MB)</div>
                    </div>
                    <input type="file" name="Foto" id="fotoInputEditar" accept="image/*" style="display: none;" onchange="previewFotoEditar(this)" />
                    <div id="previewContainerEditar" class="image-preview" style="display: none;">
                        <img id="previewFotoEditar" src="" alt="Vista previa" />
                        <button type="button" class="remove-image" onclick="removerFotoEditar()">✕</button>
                    </div>
                </div>
                
                <!-- Estado - Se puede editar -->
                <div class="form-group">
                    <label><i class="fas fa-toggle-on"></i> Estado</label>
                    <div class="radio-group">
                        <label>
                            <input type="radio" name="Activo" value="true" id="editActivoTrue" /> 
                            <span class="estado-activo-card">Activo</span>
                        </label>
                        <label>
                            <input type="radio" name="Activo" value="false" id="editActivoFalse" /> 
                            <span class="estado-inactivo-card">Inactivo</span>
                        </label>
                    </div>
                </div>
                
                <div class="form-group">
                    <label><input type="checkbox" name="EliminarFoto" value="true" /> Eliminar foto actual</label>
                </div>
                
                <button type="submit" class="btn-submit">
                    <i class="fas fa-save"></i> Guardar cambios
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function mostrarModalNuevo() {
        var modal = document.getElementById('modalNuevo');
        if (modal) {
            modal.style.display = 'block';
            document.body.style.overflow = 'hidden';
            document.getElementById('formNuevo').reset();
            removerFotoNuevo();
        }
    }
    
    function cerrarModalNuevo() {
        var modal = document.getElementById('modalNuevo');
        if (modal) {
            modal.style.display = 'none';
            document.body.style.overflow = 'auto';
        }
    }
    
    function previewFotoNuevo(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('previewFotoNuevo').src = e.target.result;
                document.getElementById('previewContainerNuevo').style.display = 'block';
                document.getElementById('uploadAreaNuevo').style.display = 'none';
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
    
    function removerFotoNuevo() {
        document.getElementById('fotoInputNuevo').value = '';
        document.getElementById('previewContainerNuevo').style.display = 'none';
        document.getElementById('uploadAreaNuevo').style.display = 'block';
    }
    
    // ==================== MODAL EDITAR ====================
    function mostrarModalEditar(id) {
        fetch('/Admin/ObtenerEstilista/' + id)
            .then(function(response) {
                return response.json();
            })
            .then(function(data) {
                if (data.success) {
                    document.getElementById('editId').value = data.estilista.id;
                    document.getElementById('editNombre').value = data.estilista.nombre;
                    document.getElementById('editEspecialidad').value = data.estilista.especialidad || '';
                    document.getElementById('editInicioTrabajo').value = data.estilista.horaInicioTrabajo;
                    document.getElementById('editFinTrabajo').value = data.estilista.horaFinTrabajo;
                    document.getElementById('editInicioDescanso').value = data.estilista.horaInicioDescanso;
                    document.getElementById('editFinDescanso').value = data.estilista.horaFinDescanso;
                    
                    if (data.estilista.activo === true) {
                        document.getElementById('editActivoTrue').checked = true;
                    } else {
                        document.getElementById('editActivoFalse').checked = true;
                    }
                    
                    var modal = document.getElementById('modalEditar');
                    if (modal) {
                        modal.style.display = 'block';
                        document.body.style.overflow = 'hidden';
                    }
                    removerFotoEditar();
                } else {
                    alert('Error al cargar el estilista');
                }
            })
            .catch(function(error) {
                console.error('Error:', error);
                alert('Error al cargar el estilista');
            });
    }
    
    function cerrarModalEditar() {
        var modal = document.getElementById('modalEditar');
        if (modal) {
            modal.style.display = 'none';
            document.body.style.overflow = 'auto';
        }
    }
    
    function previewFotoEditar(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('previewFotoEditar').src = e.target.result;
                document.getElementById('previewContainerEditar').style.display = 'block';
                document.getElementById('uploadAreaEditar').style.display = 'none';
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
    
    function removerFotoEditar() {
        document.getElementById('fotoInputEditar').value = '';
        document.getElementById('previewContainerEditar').style.display = 'none';
        document.getElementById('uploadAreaEditar').style.display = 'block';
    }
    
    // ==================== ELIMINAR ====================
    function eliminarEstilista(id, nombre) {
        if (!confirm(`¿Eliminar permanentemente al estilista "${nombre}"?`)) return;
        
        fetch('/Admin/EliminarEstilista/' + id, { method: 'POST' })
            .then(function(response) {
                return response.json();
            })
            .then(function(data) {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Error al eliminar');
                }
            })
            .catch(function(error) {
                alert('Error en la solicitud');
            });
    }
    
    // ==================== CERRAR MODAL AL HACER CLIC FUERA ====================
    window.onclick = function(event) {
        var modalNuevo = document.getElementById('modalNuevo');
        var modalEditar = document.getElementById('modalEditar');
        
        if (event.target === modalNuevo) {
            cerrarModalNuevo();
        }
        if (event.target === modalEditar) {
            cerrarModalEditar();
        }
    }
    
    // ==================== INICIALIZAR DRAG & DROP ====================
    function setupDragAndDrop(areaId, inputId, previewFunc) {
        var area = document.getElementById(areaId);
        if (!area) return;
        
        area.addEventListener('dragover', function(e) {
            e.preventDefault();
            area.classList.add('dragover');
        });
        
        area.addEventListener('dragleave', function(e) {
            area.classList.remove('dragover');
        });
        
        area.addEventListener('drop', function(e) {
            e.preventDefault();
            area.classList.remove('dragover');
            var files = e.dataTransfer.files;
            if (files.length > 0) {
                document.getElementById(inputId).files = files;
                if (previewFunc) previewFunc(document.getElementById(inputId));
            }
        });
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        setupDragAndDrop('uploadAreaNuevo', 'fotoInputNuevo', function(input) { previewFotoNuevo(input); });
        setupDragAndDrop('uploadAreaEditar', 'fotoInputEditar', function(input) { previewFotoEditar(input); });

        // ==================== SUBMIT FORM NUEVO (FETCH) ====================
        document.getElementById('formNuevo').addEventListener('submit', function(e) {
            e.preventDefault();

            var formData = new FormData(this);

            fetch('/Admin/CrearEstilista', {
                method: 'POST',
                body: formData
            })
            .then(function(response) { return response.json(); })
            .then(function(data) {
                if (data.success) {
                    cerrarModalNuevo();
                    location.reload();
                } else {
                    alert(data.message || 'Error al crear estilista');
                }
            })
            .catch(function() {
                alert('Error en la solicitud');
            });
        });

        console.log('Admin estilistas cargado correctamente');
    });
</script>