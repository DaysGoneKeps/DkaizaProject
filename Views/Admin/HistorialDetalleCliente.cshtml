@model List<DkaizaProject.Models.Cita>
@{
    ViewData["Title"] = "Historial de Cliente";
    Layout = "_Layout";
    var cliente    = (DkaizaProject.Models.Cliente)ViewBag.Cliente;
    var asistencias   = (int)ViewBag.Asistencias;
    var cancelaciones = (int)ViewBag.Cancelaciones;
    var ausencias     = (int)ViewBag.Ausencias;
    var totalReg      = (int)ViewBag.TotalRegistros;
    string desde = ViewBag.Desde ?? "";
    string hasta  = ViewBag.Hasta  ?? "";

    var initials = string.Join("", cliente.NombreCompleto.Split(' ').Take(2).Select(p => p.Length > 0 ? p[0].ToString().ToUpper() : ""));
    var colors = new[]{"#7a5c3e","#5b8dd9","#4caf82","#e8874a","#d4a843","#d96c5c","#9b6bb5"};
    var avatarColor = colors[Math.Abs(cliente.NombreCompleto.GetHashCode()) % colors.Length];

    string IcoCheck = @"<svg width=""13"" height=""13"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2.2"" stroke-linecap=""round"" stroke-linejoin=""round"" aria-hidden=""true""><polyline points=""20 6 9 17 4 12""/></svg>";

    string IcoX = @"<svg width=""13"" height=""13"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2.2"" stroke-linecap=""round"" stroke-linejoin=""round"" aria-hidden=""true""><line x1=""18"" y1=""6"" x2=""6"" y2=""18""/><line x1=""6"" y1=""6"" x2=""18"" y2=""18""/></svg>";

    string IcoWarning = @"<svg width=""13"" height=""13"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2.2"" stroke-linecap=""round"" stroke-linejoin=""round"" aria-hidden=""true""><path d=""M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z""/><line x1=""12"" y1=""9"" x2=""12"" y2=""13""/><line x1=""12"" y1=""17"" x2=""12.01"" y2=""17""/></svg>";

    string IcoStar = @"<svg width=""14"" height=""14"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""1.8"" stroke-linecap=""round"" stroke-linejoin=""round"" aria-hidden=""true""><polygon points=""12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2""/></svg>";

    string IcoUser = @"<svg width=""14"" height=""14"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""1.8"" stroke-linecap=""round"" stroke-linejoin=""round"" aria-hidden=""true""><path d=""M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2""/><circle cx=""12"" cy=""7"" r=""4""/></svg>";

    string IcoCalendario = @"<svg width=""14"" height=""14"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""1.8"" stroke-linecap=""round"" stroke-linejoin=""round"" aria-hidden=""true""><rect x=""3"" y=""4"" width=""18"" height=""18"" rx=""2""/><path d=""M16 2v4M8 2v4M3 10h18""/></svg>";
}

<style>
    :root {
        --cream:#f8f4ef; --sand:#e8ddd0; --mocha:#c4a882; --espresso:#7a5c3e;
        --dark:#2d1f12; --white:#ffffff;
        --green:#4caf82; --orange:#e8874a; --red:#d96c5c; --blue:#5b8dd9; --vip:#d4a843;
        --radius:12px; --shadow:0 2px 12px rgba(45,31,18,.08);
    }
    .det-page { background:var(--cream); min-height:100vh; padding:32px 0 60px; }
    .det-container { max-width:960px; margin:0 auto; padding:0 24px; }

    /* Breadcrumb */
    .breadcrumb { display:flex; align-items:center; gap:8px; font-size:13px; color:var(--espresso); margin-bottom:24px; }
    .breadcrumb a { color:var(--espresso); text-decoration:none; }
    .breadcrumb a:hover { text-decoration:underline; }
    .breadcrumb span { opacity:.5; }

    /* Client header card */
    .client-card { background:var(--white); border-radius:var(--radius); border:1px solid var(--sand); padding:24px 28px; box-shadow:var(--shadow); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; margin-bottom:20px; }
    .client-card-left { display:flex; align-items:center; gap:16px; }
    .avatar-lg { width:52px; height:52px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:18px; font-weight:700; color:#fff; flex-shrink:0; }
    .client-name { font-size:22px; font-weight:800; color:var(--dark); letter-spacing:-.4px; }
    .client-sub  { font-size:13px; color:var(--espresso); margin-top:2px; }
    .vip-actions { display:flex; gap:8px; }
    .btn-vip     { display:inline-flex; align-items:center; gap:6px; padding:8px 16px; border-radius:8px; border:1.5px solid var(--vip); background:#fff8e6; color:#9a7018; font-size:13px; font-weight:600; cursor:pointer; transition:all .15s; }
    .btn-vip:hover { background:#fff0c8; }
    .btn-quitar  { display:inline-flex; align-items:center; gap:6px; padding:8px 16px; border-radius:8px; border:1.5px solid var(--sand); background:var(--white); color:var(--espresso); font-size:13px; font-weight:600; cursor:pointer; transition:all .15s; }
    .btn-quitar:hover { background:var(--sand); }

    /* KPI row */
    .kpi-row { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:20px; }
    @@media(max-width:600px){ .kpi-row{ grid-template-columns:repeat(2,1fr); } }
    .kpi-sm { background:var(--white); border-radius:var(--radius); border:1px solid var(--sand); padding:16px 18px; box-shadow:var(--shadow); }
    .kpi-sm .kv { font-size:26px; font-weight:800; line-height:1; }
    .kpi-sm .kl { font-size:12px; text-transform:uppercase; letter-spacing:.6px; color:var(--espresso); margin-top:6px; font-weight:500; }
    .kv-gray  { color:var(--dark); }
    .kv-green { color:var(--green); }
    .kv-red   { color:var(--red); }
    .kv-orange{ color:var(--orange); }

    /* Filter */
    .filter-card { background:var(--white); border-radius:var(--radius); border:1px solid var(--sand); padding:18px 22px; margin-bottom:20px; box-shadow:var(--shadow); }
    .filter-title { display:flex; align-items:center; gap:6px; font-size:13px; font-weight:600; color:var(--espresso); margin-bottom:14px; }
    .filter-row { display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap; }
    .filter-group { display:flex; flex-direction:column; gap:5px; }
    .filter-group label { font-size:12px; color:var(--espresso); font-weight:500; }
    .filter-group input { padding:8px 12px; border-radius:7px; border:1.5px solid var(--sand); font-size:13px; color:var(--dark); background:var(--cream); outline:none; transition:border .15s; }
    .filter-group input:focus { border-color:var(--mocha); background:var(--white); }
    .btn-filtrar { padding:9px 20px; border-radius:7px; background:var(--espresso); color:#fff; border:none; font-size:13px; font-weight:600; cursor:pointer; transition:background .15s; }
    .btn-filtrar:hover { background:var(--dark); }

    /* Table */
    .table-wrap { background:var(--white); border-radius:var(--radius); border:1px solid var(--sand); overflow:hidden; box-shadow:var(--shadow); }
    .table-header { display:flex; align-items:center; justify-content:space-between; padding:15px 20px; border-bottom:1px solid var(--sand); }
    .th-title { font-size:15px; font-weight:700; color:var(--dark); }
    .th-sub   { font-size:12px; color:var(--espresso); }
    .badge-date { display:inline-flex; align-items:center; gap:5px; font-size:12px; color:var(--espresso); background:var(--cream); border-radius:6px; padding:4px 10px; border:1px solid var(--sand); }
    table.det-table { width:100%; border-collapse:collapse; }
    table.det-table thead th { padding:10px 16px; text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:.7px; color:var(--espresso); border-bottom:1px solid var(--sand); background:var(--cream); font-weight:600; }
    table.det-table tbody tr { border-bottom:1px solid #f3ede6; transition:background .12s; }
    table.det-table tbody tr:last-child { border-bottom:none; }
    table.det-table tbody tr:hover { background:#fdf9f6; }
    table.det-table td { padding:12px 16px; font-size:13.5px; color:var(--dark); vertical-align:middle; }

    /* Estado chips */
    .chip { display:inline-flex; align-items:center; gap:5px; border-radius:99px; padding:4px 11px; font-size:12px; font-weight:600; }
    .chip-asistio     { background:#eafaf2; color:#2e8a5c; border:1px solid #b2e8ce; }
    .chip-cancelo     { background:#fef2f1; color:#b94037; border:1px solid #f5bab6; }
    .chip-noasistio   { background:#fff4e8; color:#b05c1a; border:1px solid #f5d5aa; }
    .chip-pendiente   { background:#f0f4ff; color:#3a5cb5; border:1px solid #c0cff5; }
    .chip-completada  { background:#eafaf2; color:#2e8a5c; border:1px solid #b2e8ce; }
    .chip-pagada      { background:#eafaf2; color:#2e8a5c; border:1px solid #b2e8ce; }
    .chip-enproceso   { background:#fff8e6; color:#9a7018; border:1px solid #f0d98a; }
    .chip-confirmada  { background:#eef4ff; color:#3060b8; border:1px solid #b0c8f8; }

    /* empty */
    .empty-det { text-align:center; padding:48px; color:var(--espresso); }
    .empty-det .emp-icon { display:flex; justify-content:center; margin-bottom:10px; opacity:.45; }
</style>

<div class="det-page">
  <div class="det-container">

    <!-- Breadcrumb -->
    <div class="breadcrumb">
      <a href="/Admin">Dashboard</a>
      <span>/</span>
      <a href="/Admin/HistorialClientes">Historial de Clientes</a>
      <span>/</span>
      <strong>@cliente.NombreCompleto</strong>
    </div>

    <!-- Client card -->
    <div class="client-card">
      <div class="client-card-left">
        <div class="avatar-lg" style="background:@avatarColor">@initials</div>
        <div>
          <div class="client-name">@cliente.NombreCompleto</div>
          <div class="client-sub">Análisis detallado de historial &nbsp;·&nbsp; @cliente.Email</div>
        </div>
      </div>
      <div class="vip-actions" id="vipActions" data-cliente-id="@cliente.Id" data-es-vip="@cliente.EsVip.ToString().ToLower()">
        <button class="btn-vip" id="btnVip" onclick="toggleVip()">
          @Html.Raw(IcoStar) Cliente VIP
        </button>
        <button class="btn-quitar" id="btnQuitar" onclick="toggleVip()">
          @Html.Raw(IcoUser) Quitar VIP
        </button>
      </div>
    </div>

    <!-- KPI row -->
    <div class="kpi-row">
      <div class="kpi-sm"><div class="kv kv-gray">@totalReg</div><div class="kl">Total Registros</div></div>
      <div class="kpi-sm"><div class="kv kv-green">@asistencias</div><div class="kl">Asistencias</div></div>
      <div class="kpi-sm"><div class="kv kv-red">@cancelaciones</div><div class="kl">Cancelaciones</div></div>
      <div class="kpi-sm"><div class="kv kv-orange">@ausencias</div><div class="kl">Ausencias</div></div>
    </div>

    <!-- Filter -->
    <div class="filter-card">
      <div class="filter-title">
        @Html.Raw(IcoCalendario) Filtrar por Rango de Fechas
      </div>
      <form method="get" action="/Admin/HistorialDetalleCliente/@cliente.Id">
        <div class="filter-row">
          <div class="filter-group">
            <label>Fecha inicio</label>
            <input type="date" name="desde" value="@desde" placeholder="dd/mm/aaaa" />
          </div>
          <div class="filter-group">
            <label>Fecha fin</label>
            <input type="date" name="hasta" value="@hasta" placeholder="dd/mm/aaaa" />
          </div>
          <button type="submit" class="btn-filtrar">Filtrar</button>
          @if (!string.IsNullOrEmpty(desde) || !string.IsNullOrEmpty(hasta))
          {
            <a href="/Admin/HistorialDetalleCliente/@cliente.Id" class="btn-quitar" style="text-decoration:none;">Limpiar</a>
          }
        </div>
      </form>
    </div>

    <!-- Table -->
    <div class="table-wrap">
      <div class="table-header">
        <div>
          <div class="th-title">Historial Detallado</div>
          <div class="th-sub">Mostrando @Model.Count registro(s)</div>
        </div>
        <div class="badge-date">
          @Html.Raw(IcoCalendario) Ordenado por fecha
        </div>
      </div>

      @if (!Model.Any())
      {
        <div class="empty-det">
          <div class="emp-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <p>No hay registros para el rango seleccionado.</p>
        </div>
      }
      else
      {
        <table class="det-table">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Servicio</th>
              <th>Estilista</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var c in Model)
            {
              string estadoDisplay;
              string chipClass;
              string icoEstado;

              if (c.Estado == EstadoCita.Completada || c.Estado == EstadoCita.Pagada)
              {
                estadoDisplay = "Asistió";
                chipClass = "chip-asistio";
                icoEstado = IcoCheck;
              }
              else if (c.Estado == EstadoCita.Cancelada)
              {
                estadoDisplay = "Canceló";
                chipClass = "chip-cancelo";
                icoEstado = IcoX;
              }
              else if (c.Fecha.Date < DateTime.Today)
              {
                estadoDisplay = "No Asistió";
                chipClass = "chip-noasistio";
                icoEstado = IcoWarning;
              }
              else
              {
                estadoDisplay = c.Estado.ToString();
                chipClass = "chip-" + c.Estado.ToString().ToLower().Replace(" ", "");
                icoEstado = "";
              }

              <tr>
                <td>@c.Fecha.ToString("dd MMM yyyy")</td>
                <td>@(c.Servicio?.Nombre ?? "—")</td>
                <td>@(c.Estilista?.Nombre ?? "—")</td>
                <td>
                  <span class="chip @chipClass">
                    @Html.Raw(icoEstado) @estadoDisplay
                  </span>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>

  </div>
</div>

<script>
(function(){
    const el = document.getElementById('vipActions');
    const btnVip    = document.getElementById('btnVip');
    const btnQuitar = document.getElementById('btnQuitar');

    function updateButtons(esVip) {
        btnVip.style.display    = esVip ? 'none' : 'inline-flex';
        btnQuitar.style.display = esVip ? 'inline-flex' : 'none';
    }

    updateButtons(el.dataset.esVip === 'true');

    window.toggleVip = async function() {
        const clienteId = el.dataset.clienteId;
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const res = await fetch(`/Admin/ToggleVip/${clienteId}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.success) {
                el.dataset.esVip = data.esVip.toString();
                updateButtons(data.esVip);
            }
        } catch(e) { console.error(e); }
    };
})();
</script>

@Html.AntiForgeryToken()
