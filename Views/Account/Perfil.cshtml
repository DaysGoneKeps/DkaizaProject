<!-- Views/Account/Perfil.cshtml -->
@model DkaizaProject.Models.PerfilViewModel
@{
    ViewData["Title"] = "Mi Perfil";
    Layout = "_Layout";
}

<section class="perfil-page">
    <div class="container">
        <!-- Header -->
        <div class="perfil-header">
            <div class="perfil-header-content">
                <div class="perfil-avatar">
                    <i class="fas fa-user-circle"></i>
                </div>
                <div class="perfil-title">
                    <h1>Mi Perfil</h1>
                    <p>Gestiona tu información personal</p>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="toast-custom toast-success" id="successToast">
                @TempData["Success"]
            </div>
        }

        <div class="perfil-content">
            <div class="perfil-sidebar">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fas fa-id-card"></i>
                        <h3>Información de la cuenta</h3>
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <span class="info-label">Miembro desde:</span>
                            <span class="info-value">@Model.FechaRegistro.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">ID Cliente:</span>
                            <span class="info-value">#@Model.Id</span>
                        </div>
                        <div class="info-divider"></div>
                        <div class="stats-summary">
                            <div class="stat-item">
                                <i class="fas fa-calendar-check"></i>
                                <div>
                                    <span class="stat-number" id="citasCount">-</span>
                                    <span class="stat-label">Citas realizadas</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="perfil-main">
                <form asp-action="ActualizarPerfil" method="post" class="perfil-form" id="perfilForm">
                    @Html.AntiForgeryToken()
                    
                    <div class="form-card">
                        <div class="form-card-header">
                            <i class="fas fa-user-edit"></i>
                            <h3>Datos personales</h3>
                        </div>
                        
                        <div class="form-card-body">
                            <div class="form-row">
                                <div class="form-group">
                                    <label asp-for="Nombre">Nombre</label>
                                    <div class="input-wrapper">
                                        <i class="fas fa-user"></i>
                                        <input asp-for="Nombre" class="form-control" placeholder="Tu nombre" />
                                    </div>
                                    <span asp-validation-for="Nombre" class="field-error"></span>
                                </div>
                                
                                <div class="form-group">
                                    <label asp-for="Apellido">Apellido</label>
                                    <div class="input-wrapper">
                                        <i class="fas fa-user"></i>
                                        <input asp-for="Apellido" class="form-control" placeholder="Tu apellido" />
                                    </div>
                                    <span asp-validation-for="Apellido" class="field-error"></span>
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label asp-for="Email">Correo electrónico</label>
                                <div class="input-wrapper">
                                    <i class="fas fa-envelope"></i>
                                    <input asp-for="Email" class="form-control" placeholder="tu@email.com" />
                                </div>
                                <span asp-validation-for="Email" class="field-error"></span>
                            </div>
                            
                            <div class="form-group">
                                <label asp-for="Telefono">Teléfono</label>
                                <div class="input-wrapper">
                                    <i class="fas fa-phone"></i>
                                    <input asp-for="Telefono" class="form-control" placeholder="+56 9 1234 5678" />
                                </div>
                                <span asp-validation-for="Telefono" class="field-error"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-card">
                        <div class="form-card-header">
                            <i class="fas fa-lock"></i>
                            <h3>Cambiar contraseña</h3>
                            <span class="optional-badge">Opcional</span>
                        </div>
                        
                        <div class="form-card-body">
                            <div class="form-group">
                                <label asp-for="NuevaPassword">Nueva contraseña</label>
                                <div class="input-wrapper">
                                    <i class="fas fa-key"></i>
                                    <input asp-for="NuevaPassword" type="password" class="form-control" placeholder="••••••" />
                                </div>
                                <span asp-validation-for="NuevaPassword" class="field-error"></span>
                            </div>
                            
                            <div class="form-group">
                                <label asp-for="ConfirmarPassword">Confirmar contraseña</label>
                                <div class="input-wrapper">
                                    <i class="fas fa-check-circle"></i>
                                    <input asp-for="ConfirmarPassword" type="password" class="form-control" placeholder="••••••" />
                                </div>
                                <span asp-validation-for="ConfirmarPassword" class="field-error"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-actions">
                        <button type="submit" class="btn-primary">
                            <i class="fas fa-save"></i>
                            Guardar cambios
                        </button>
                        <a href="/" class="btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Cargar conteo de citas
        async function loadCitasCount() {
            try {
                const response = await fetch('/Appointments/MisCitasCount');
                const data = await response.json();
                if (data.success) {
                    document.getElementById('citasCount').textContent = data.count;
                } else {
                    document.getElementById('citasCount').textContent = '0';
                }
            } catch (error) {
                document.getElementById('citasCount').textContent = '0';
            }
        }
        
        loadCitasCount();
        
        // Auto ocultar toast
        const toast = document.getElementById('successToast');
        if (toast) {
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>
}