@model DkaizaProject.Models.LoginViewModel
@{
    ViewData["Title"] = "Ingresar";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <span class="auth-logo">✦</span>
            <h1>Bienvenida de vuelta</h1>
            <p>Ingresa tus datos para continuar</p>
        </div>

        <form asp-action="Login" method="post" class="auth-form">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert-error"></div>

            <div class="form-field">
                <label asp-for="Email">Correo electrónico</label>
                <input asp-for="Email" type="email" placeholder="tu@email.com" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="Password">Contraseña</label>
                <input asp-for="Password" type="password" placeholder="••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <button type="submit" class="btn-auth">Ingresar →</button>
        </form>

        <div class="auth-footer">
            ¿No tienes cuenta? <a href="/Account/Register">Regístrate gratis</a>
        </div>
    </div>
</div>
