<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — D'KAIZA | Salón de Belleza</title>
    
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    
    <style>
        /* ============================================================
           ESTILOS: Dropdown de usuario + Perfil
           ============================================================ */

        .user-menu-container {
            position: relative;
            margin-left: 0.5rem;
        }

        .user-menu-trigger {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 12px;
            background: var(--cream-dark);
            border-radius: 40px;
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid var(--border);
        }

        .user-menu-trigger:hover {
            background: var(--white);
            border-color: var(--rose);
        }

        .user-avatar-mini {
            width: 32px;
            height: 32px;
            background: var(--rose-light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .user-avatar-mini i {
            font-size: 1.1rem;
            color: var(--rose-dark);
        }

        .user-info-mini {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .user-name-mini {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--ink);
        }

        .user-info-mini i {
            font-size: 0.7rem;
            color: var(--ink-light);
            transition: transform 0.2s;
        }

        .user-menu-container:hover .user-info-mini i {
            transform: rotate(180deg);
        }

        .user-menu-dropdown {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            min-width: 200px;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--shadow-lg);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.2s;
            z-index: 1000;
        }

        .user-menu-container:hover .user-menu-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            color: var(--ink-mid);
            text-decoration: none;
            font-size: 0.85rem;
            transition: all 0.2s;
        }

        .dropdown-item i {
            width: 20px;
            font-size: 0.9rem;
            color: var(--ink-light);
        }

        .dropdown-item:hover {
            background: var(--cream);
            color: var(--ink);
        }

        .dropdown-item:hover i {
            color: var(--rose-dark);
        }

        .dropdown-item.logout {
            color: #b83232;
        }

        .dropdown-item.logout:hover {
            background: #fdf0f0;
        }

        .dropdown-divider {
            height: 1px;
            background: var(--border);
            margin: 6px 0;
        }

        /* ============================================================
           ESTILOS: Campana de notificaciones
           ============================================================ */

        .notif-bell-btn {
            position: relative;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--cream-dark);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            color: var(--ink-mid);
            font-size: 1rem;
            margin-right: 0.25rem;
            flex-shrink: 0;
        }

        .notif-bell-btn:hover {
            background: var(--white);
            border-color: var(--rose);
            color: var(--rose-dark);
        }

        .notif-bell-badge {
            position: absolute;
            top: -3px;
            right: -3px;
            background: #e74c3c;
            color: white;
            font-size: 0.6rem;
            font-weight: 700;
            width: 17px;
            height: 17px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
            line-height: 1;
        }

        .notif-bell-badge.hidden { display: none; }

        /* ============================================================
           ESTILOS: Popup de notificaciones
           ============================================================ */

        .notif-popup-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 9998;
            background: transparent;
        }

        .notif-popup-overlay.active { display: block; }

        .notif-popup {
            position: fixed;
            top: 68px;
            right: 1.5rem;
            width: 380px;
            max-width: calc(100vw - 2rem);
            max-height: 70vh;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 12px 40px rgba(0,0,0,0.15);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transform: translateY(-8px);
            opacity: 0;
            transition: transform 0.25s ease, opacity 0.25s ease;
            pointer-events: none;
        }

        .notif-popup.active {
            transform: translateY(0);
            opacity: 1;
            pointer-events: all;
        }

        .notif-popup__header {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--cream-dark);
        }

        .notif-popup__header h4 {
            font-family: var(--font-display);
            font-size: 0.95rem;
            color: var(--ink);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .notif-popup__header h4 svg {
            width: 17px;
            height: 17px;
            color: var(--rose-dark);
            flex-shrink: 0;
        }

        .notif-popup__close {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--ink-light);
            font-size: 1rem;
            padding: 4px 8px;
            border-radius: 8px;
            transition: all 0.15s;
        }

        .notif-popup__close:hover { background: var(--border); color: var(--ink); }

        .notif-popup__body {
            overflow-y: auto;
            flex: 1;
            padding: 0.75rem;
        }

        .notif-popup-item {
            border: 1px solid var(--border);
            border-left: 3px solid var(--rose);
            border-radius: 10px;
            padding: 0.85rem 1rem;
            margin-bottom: 0.75rem;
            background: var(--cream);
            transition: background 0.15s, opacity 0.3s;
        }

        .notif-popup-item:last-child { margin-bottom: 0; }

        .notif-popup-item__title {
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--ink);
            margin-bottom: 0.3rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .notif-popup-item__title svg {
            width: 14px;
            height: 14px;
            color: var(--rose-dark);
            flex-shrink: 0;
        }

        .notif-popup-item__msg {
            font-size: 0.8rem;
            color: var(--ink-mid);
            margin-bottom: 0.6rem;
            line-height: 1.45;
        }

        .notif-popup-item__detail {
            font-size: 0.75rem;
            color: var(--ink-light);
            display: flex;
            flex-wrap: wrap;
            gap: 0.3rem 0.9rem;
            margin-bottom: 0.75rem;
            background: white;
            border-radius: 6px;
            padding: 0.4rem 0.6rem;
        }

        .notif-popup-item__detail span {
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .notif-popup-item__detail svg {
            width: 11px;
            height: 11px;
            color: var(--rose-dark);
            opacity: 0.8;
            flex-shrink: 0;
        }

        .notif-popup-item__btns {
            display: flex;
            gap: 0.5rem;
        }

        .notif-popup-item__btns button {
            flex: 1;
            padding: 6px 10px;
            border-radius: 50px;
            font-size: 0.68rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            white-space: nowrap;
        }

        .notif-popup-item__btns button svg {
            width: 12px;
            height: 12px;
            flex-shrink: 0;
        }

        .btn-pp-confirmar { background: var(--ink); color: white; }
        .btn-pp-confirmar:hover { background: var(--rose-dark); }
        .btn-pp-cancelar  { background: white; border: 1px solid #e0b4b4 !important; color: #c0392b; }
        .btn-pp-cancelar:hover { background: #fdf0f0; }

        .notif-popup__footer {
            padding: 0.75rem 1rem;
            border-top: 1px solid var(--border);
            text-align: center;
        }

        .notif-popup__footer a {
            font-size: 0.8rem;
            color: var(--rose-dark);
            text-decoration: none;
            font-weight: 500;
        }

        .notif-popup__footer a:hover { text-decoration: underline; }

        .notif-popup__empty {
            text-align: center;
            padding: 2rem 1rem;
            color: var(--ink-light);
            font-size: 0.85rem;
        }

        .notif-popup__empty svg {
            width: 36px;
            height: 36px;
            display: block;
            margin: 0 auto 0.6rem;
            color: var(--rose);
            opacity: 0.6;
        }

        /* ============================================================
           ESTILOS: Página de Perfil
           ============================================================ */

        .perfil-page {
            padding: 2rem 0 4rem;
            background: linear-gradient(135deg, var(--cream) 0%, var(--white) 100%);
            min-height: calc(100vh - 200px);
        }

        .perfil-header {
            background: linear-gradient(135deg, var(--ink) 0%, var(--rose-dark) 100%);
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 2rem;
            color: white;
            position: relative;
            overflow: hidden;
        }

        .perfil-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            pointer-events: none;
        }

        .perfil-header-content {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            position: relative;
            z-index: 2;
        }

        .perfil-avatar {
            width: 80px;
            height: 80px;
            background: rgba(255,255,255,0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(10px);
        }

        .perfil-avatar i { font-size: 3rem; color: var(--white); }

        .perfil-title h1 {
            font-family: var(--font-display);
            font-size: 2rem;
            margin-bottom: 0.25rem;
        }

        .perfil-title p { color: rgba(255,255,255,0.8); font-size: 0.9rem; }

        .perfil-content {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 2rem;
        }

        .info-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            position: sticky;
            top: 80px;
        }

        .info-card-header {
            background: linear-gradient(135deg, var(--rose-light) 0%, var(--cream-dark) 100%);
            padding: 1.25rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .info-card-header i { font-size: 1.25rem; color: var(--rose-dark); }

        .info-card-header h3 {
            font-family: var(--font-display);
            font-size: 1rem;
            font-weight: 600;
            color: var(--ink);
            margin: 0;
        }

        .info-card-body { padding: 1.25rem; }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--border);
        }

        .info-row:last-child { border-bottom: none; }
        .info-label { font-size: 0.8rem; color: var(--ink-light); }
        .info-value { font-weight: 500; color: var(--ink); font-size: 0.85rem; }
        .info-divider { height: 1px; background: var(--border); margin: 1rem 0; }

        .stats-summary { margin-top: 0.5rem; }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 0;
        }

        .stat-item i { font-size: 1.1rem; color: var(--rose-dark); width: 24px; }

        .stat-item div { display: flex; flex-direction: column; }

        .stat-number {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--ink);
            line-height: 1;
        }

        .stat-label { font-size: 0.7rem; color: var(--ink-light); }

        .form-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 16px;
            margin-bottom: 1.5rem;
            overflow: hidden;
        }

        .form-card-header {
            padding: 1.25rem;
            background: var(--cream-dark);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            position: relative;
        }

        .form-card-header i { font-size: 1.1rem; color: var(--rose-dark); }

        .form-card-header h3 {
            font-family: var(--font-display);
            font-size: 1rem;
            font-weight: 600;
            color: var(--ink);
            margin: 0;
        }

        .optional-badge {
            margin-left: auto;
            font-size: 0.7rem;
            background: var(--border);
            padding: 2px 8px;
            border-radius: 20px;
            color: var(--ink-light);
        }

        .form-card-body { padding: 1.5rem; }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .form-group { margin-bottom: 1.25rem; }

        .form-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--ink-mid);
            margin-bottom: 0.5rem;
        }

        .input-wrapper { position: relative; }

        .input-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--ink-light);
            font-size: 0.9rem;
            pointer-events: none;
        }

        .form-control {
            width: 100%;
            padding: 10px 12px 10px 38px;
            border: 1px solid var(--border-mid);
            border-radius: 10px;
            font-size: 0.85rem;
            font-family: var(--font-body);
            color: var(--ink);
            background: var(--cream);
            transition: all 0.2s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--rose);
            background: var(--white);
            box-shadow: 0 0 0 3px rgba(200, 169, 138, 0.1);
        }

        .field-error { font-size: 0.7rem; color: #c0392b; margin-top: 0.25rem; display: block; }

        .form-actions {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
            margin-top: 1.5rem;
        }

        .btn-primary {
            background: var(--ink);
            color: var(--white);
            border: none;
            padding: 12px 28px;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }

        .btn-primary:hover { background: var(--rose-dark); transform: translateY(-1px); }

        .btn-secondary {
            background: transparent;
            color: var(--ink-mid);
            border: 1px solid var(--border-mid);
            padding: 12px 28px;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-secondary:hover { border-color: var(--ink-mid); color: var(--ink); }

        /* ============================================================
           ESTILOS: Chatbot flotante
           ============================================================ */

        #sg-chat-btn {
            position: fixed;
            bottom: 28px;
            right: 28px;
            width: 54px;
            height: 54px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--ink), var(--rose-dark));
            color: #fff;
            border: none;
            display: grid;
            place-items: center;
            font-size: 1.3rem;
            box-shadow: 0 8px 24px rgba(0,0,0,0.2);
            z-index: 9980;
            cursor: pointer;
            transition: transform 0.2s;
        }
        #sg-chat-btn:hover { transform: translateY(-3px) scale(1.05); }

        #sg-chat-box {
            position: fixed;
            bottom: 96px;
            right: 28px;
            width: 340px;
            max-width: calc(100vw - 40px);
            max-height: 480px;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 20px;
            box-shadow: 0 16px 48px rgba(0,0,0,0.16);
            display: none;
            flex-direction: column;
            overflow: hidden;
            z-index: 9979;
        }

        #sg-chat-header {
            background: linear-gradient(135deg, var(--ink), var(--rose-dark));
            color: #fff;
            padding: 14px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 500;
            font-size: 0.9rem;
            flex-shrink: 0;
        }
        #sg-chat-close {
            background: none;
            border: none;
            color: #fff;
            font-size: 1rem;
            cursor: pointer;
            padding: 2px 6px;
            border-radius: 6px;
            transition: background 0.15s;
        }
        #sg-chat-close:hover { background: rgba(255,255,255,0.2); }

        #sg-chat-messages {
            padding: 12px;
            flex: 1;
            overflow-y: auto;
            background: var(--cream);
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sg-msg-bot, .sg-msg-user {
            padding: 9px 13px;
            border-radius: 14px;
            font-size: 0.83rem;
            line-height: 1.45;
            max-width: 88%;
            word-break: break-word;
        }
        .sg-msg-bot {
            background: var(--white);
            border: 1px solid var(--border);
            border-bottom-left-radius: 4px;
            align-self: flex-start;
        }
        .sg-msg-user {
            background: var(--ink);
            color: #fff;
            border-bottom-right-radius: 4px;
            align-self: flex-end;
        }

        #sg-chat-input {
            display: flex;
            gap: 8px;
            padding: 10px 12px;
            border-top: 1px solid var(--border);
            background: var(--white);
            flex-shrink: 0;
        }
        #sg-chat-text {
            flex: 1;
            border: 1px solid var(--border-mid);
            border-radius: 50px;
            padding: 8px 14px;
            font-size: 0.83rem;
            font-family: var(--font-body);
            background: var(--cream);
            outline: none;
            transition: border-color 0.2s;
        }
        #sg-chat-text:focus { border-color: var(--rose); background: white; }
        #sg-chat-send {
            background: var(--ink);
            border: none;
            border-radius: 50px;
            padding: 8px 16px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #fff;
            cursor: pointer;
            font-size: 0.82rem;
            font-weight: 500;
            font-family: var(--font-body);
            transition: background 0.2s;
            flex-shrink: 0;
            white-space: nowrap;
        }
        #sg-chat-send:hover { background: var(--rose-dark); }

        .sg-suggestions {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-top: 10px;
        }

        .sg-suggestion-btn {
            background: var(--white);
            border: 1.5px solid var(--rose);
            border-radius: 50px;
            padding: 7px 14px;
            font-size: 0.78rem;
            color: var(--rose-dark);
            cursor: pointer;
            text-align: left;
            font-family: var(--font-body);
            transition: all 0.2s;
            line-height: 1.3;
        }

        .sg-suggestion-btn:hover {
            background: var(--rose-light);
            border-color: var(--rose-dark);
        }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @@media (max-width: 768px) {
            .perfil-content { grid-template-columns: 1fr; }
            .info-card { position: static; }
            .form-row { grid-template-columns: 1fr; }
            .perfil-header-content { flex-direction: column; text-align: center; }
            .form-actions { flex-direction: column; }
            .btn-primary, .btn-secondary { justify-content: center; }
            .user-info-mini .user-name-mini { display: none; }
            .user-menu-trigger { padding: 6px; }
            .user-info-mini i { display: none; }
            #sg-chat-btn { bottom: 20px; right: 20px; }
            #sg-chat-box { bottom: 84px; right: 16px; width: calc(100vw - 32px); }
        }
    </style>
    
    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- ========== NAVBAR ========== -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            
            <!-- Logo -->
            <a class="navbar-brand" href="/">
                <div class="logo-icon">
                    <i class="fas fa-spa"></i>
                </div>
                <div class="logo-text">
                    <span class="logo-name">D'KAIZA</span>
                    <span class="logo-tagline">Beauty Salon</span>
                </div>
            </a>

            <!-- Botón móvil -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Menú principal -->
            <div class="collapse navbar-collapse" id="navbarMain">
                @{
                    var esEstilistaNav     = Context.Session.GetString("EsEstilista")     == "True";
                    var esAdminNav         = Context.Session.GetString("EsAdmin")         == "True";
                    var esRecepcionistaNav = Context.Session.GetString("EsRecepcionista") == "True";
                    var esClienteNormal    = !esEstilistaNav && !esAdminNav && !esRecepcionistaNav;
                }
                <ul class="navbar-nav mx-auto">
                    @if (esEstilistaNav)
                    {
                        <li class="nav-item">
