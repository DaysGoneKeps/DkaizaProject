    @* ── SCRIPT DE NOTIFICACIONES (solo clientes normales) ── *@
    @if (Context.Session.GetInt32("ClienteId") != null && esClienteNormal)
    {
        <script>
        (function () {
            const bell     = document.getElementById('notifBellBtn');
            if (!bell) return;

            const badge    = document.getElementById('notifBadge');
            const popup    = document.getElementById('notifPopup');
            const overlay  = document.getElementById('notifOverlay');
            const body     = document.getElementById('notifBody');
            const closeBtn = document.getElementById('notifCloseBtn');
            let popupOpen     = false;
            let accionEnCurso = false;

            // SVGs reutilizables en JS (misma paleta cálida)
            const SVG = {
                calendario: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><circle cx="12" cy="16" r="1.2" fill="currentColor"/></svg>`,
                servicio:   `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17a1 1 0 001 1h6a1 1 0 001-1v-2.26C17.81 13.47 19 11.38 19 9c0-3.87-3.13-7-7-7z"/><path d="M9 21h6"/></svg>`,
                estilista:  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>`,
                fecha:      `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01"/></svg>`,
                hora:       `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>`,
                check:      `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>`,
                xmark:      `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>`,
                vacio:      `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M6 10C6 6.69 8.69 4 12 4C15.31 4 18 6.69 18 10C18 14 20 16 20 16H4C4 16 6 14 6 10"/><path d="M13.73 21C13.39 21.6 12.73 22 12 22C11.27 22 10.61 21.6 10.27 21"/></svg>`,
                cargando:   `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5"/><circle cx="12" cy="16" r="0.5" fill="currentColor"/></svg>`,
            };

            // ── Actualizar contador del badge ──────────────────────
            async function actualizarContador() {
                try {
                    const r = await fetch('/Notificaciones/Contador');
                    const d = await r.json();
                    if (d.count > 0) {
                        badge.textContent = d.count > 9 ? '9+' : d.count;
                        badge.classList.remove('hidden');
                    } else {
                        badge.classList.add('hidden');
                    }
                } catch (_) {}
            }

            // ── Renderizar notificaciones en el popup ──────────────
            function renderNotifs(notifs) {
                if (!notifs || notifs.length === 0) {
                    body.innerHTML = `
                        <div class="notif-popup__empty">
                            ${SVG.vacio}
                            Sin notificaciones pendientes
                        </div>`;
                    return;
                }

                body.innerHTML = notifs.map(n => `
                    <div class="notif-popup-item" id="ppitem-${n.id}">
                        <div class="notif-popup-item__title">
                            ${SVG.calendario}
                            ${n.titulo}
                        </div>
                        <div class="notif-popup-item__msg">${n.mensaje}</div>
                        <div class="notif-popup-item__detail">
                            <span>${SVG.servicio} ${n.cita.servicio}</span>
                            <span>${SVG.estilista} ${n.cita.estilista}</span>
                            <span>${SVG.fecha} ${n.cita.fecha}</span>
                            <span>${SVG.hora} ${n.cita.horaInicio} – ${n.cita.horaFin}</span>
                        </div>
                        <div class="notif-popup-item__btns">
                            <button class="btn-pp-confirmar" data-id="${n.id}">
                                Confirmar asistencia
                            </button>
                            <button class="btn-pp-cancelar" data-id="${n.id}">
                                Cancelar cita
                            </button>
                        </div>
                    </div>
                `).join('');

                body.querySelectorAll('.btn-pp-confirmar').forEach(btn =>
                    btn.addEventListener('click', () => accionPopup(btn.dataset.id, 'Confirmar')));
                body.querySelectorAll('.btn-pp-cancelar').forEach(btn =>
                    btn.addEventListener('click', () => accionPopup(btn.dataset.id, 'Cancelar')));
            }

            // ── Abrir popup ────────────────────────────────────────
            async function abrirPopup() {
                popup.classList.add('active');
                overlay.classList.add('active');
                popupOpen = true;
                body.innerHTML = `
                    <div class="notif-popup__empty">
                        ${SVG.cargando}
                        Cargando...
                    </div>`;
                try {
                    const r = await fetch('/Notificaciones/Pendientes');
                    const d = await r.json();
                    if (d.success) renderNotifs(d.notificaciones);
                } catch (_) {
                    body.innerHTML = `
                        <div class="notif-popup__empty">
                            ${SVG.cargando}
                            Error al cargar
                        </div>`;
                }
            }

            function cerrarPopup() {
                popup.classList.remove('active');
                overlay.classList.remove('active');
                popupOpen = false;
                actualizarContador();
            }

            // ── Confirmar / Cancelar desde el popup ───────────────
            async function accionPopup(id, accion) {
                const ok = accion === 'Confirmar'
                    ? confirm('¿Confirmas tu asistencia a la cita?')
                    : confirm('¿Seguro que deseas cancelar esta cita? El horario quedará libre.');
                if (!ok) return;

                const r = await fetch(`/Notificaciones/${accion}/${id}`, { method: 'POST' });
                const d = await r.json();
                if (d.success) {
                    accionEnCurso = true;
                    const item = document.getElementById('ppitem-' + id);
                    if (item) { item.style.opacity = '0'; setTimeout(() => item.remove(), 300); }
                    mostrarToast(d.message, accion === 'Confirmar' ? 'success' : 'error');
                    await actualizarContador();
                    setTimeout(() => {
                        if (body.querySelectorAll('.notif-popup-item').length === 0) {
                            body.innerHTML = `
                                <div class="notif-popup__empty">
                                    ${SVG.vacio}
                                    Sin notificaciones pendientes
                                </div>`;
                            setTimeout(cerrarPopup, 1500);
                        }
                    }, 350);
                } else {
                    alert(d.message || 'Error al procesar');
                }
            }

            // ── Toast temporal ─────────────────────────────────────
            function mostrarToast(msg, tipo) {
                const t = document.createElement('div');
                t.className = `toast-custom toast-${tipo}`;
                t.innerHTML = `<i class="fas fa-${tipo === 'success' ? 'check-circle' : 'info-circle'}"></i> ${msg}`;
                document.body.appendChild(t);
                setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 3500);
            }

            // ── Auto-popup al cargar ───────────────────────────────
            async function autoPopupSiHay() {
                if (window.location.pathname.startsWith('/Notificaciones')) return;
                if (accionEnCurso) return;
                if (sessionStorage.getItem('notifPopupMostrado')) return;
                try {
                    const r = await fetch('/Notificaciones/Contador');
                    const d = await r.json();
                    if (d.count > 0) {
                        sessionStorage.setItem('notifPopupMostrado', '1');
                        setTimeout(abrirPopup, 1200);
                    }
                } catch (_) {}
            }

            // ── Eventos ────────────────────────────────────────────
            bell.addEventListener('click', e => {
                e.stopPropagation();
                popupOpen ? cerrarPopup() : abrirPopup();
            });
            closeBtn.addEventListener('click', cerrarPopup);
            overlay.addEventListener('click', cerrarPopup);
            document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrarPopup(); });

            // ── Inicializar ────────────────────────────────────────
            actualizarContador();
            setInterval(actualizarContador, 60000);
            autoPopupSiHay();
        })();
        </script>
    }

    @RenderSection("Scripts", required: false)

   
    <script>
    (function () {
        var btn      = document.getElementById('sg-chat-btn');
        var box      = document.getElementById('sg-chat-box');
        var close    = document.getElementById('sg-chat-close');
        var messages = document.getElementById('sg-chat-messages');
        var input    = document.getElementById('sg-chat-text');
        var sendBtn  = document.getElementById('sg-chat-send');

        // Guard: si por alguna razón no existen los elementos, no explotar
        if (!btn || !box) return;

        btn.addEventListener('click', function () {
            var visible = box.style.display === 'flex';
            box.style.display = visible ? 'none' : 'flex';
            if (!visible) input.focus();
        });

        close.addEventListener('click', function () {
            box.style.display = 'none';
        });

        function appendMessage(text, cls) {
            var div = document.createElement('div');
            div.className = cls;
            div.innerHTML = text.replace(/\n/g, '<br>');
            messages.appendChild(div);
            messages.scrollTop = messages.scrollHeight;
            return div;
        }

        async function sendMessage() {
            var text = input.value.trim();
            if (!text) return;

            appendMessage(text, 'sg-msg-user');
            input.value = '';
            input.disabled = true;
            sendBtn.disabled = true;

            var loading = appendMessage('Escribiendo...', 'sg-msg-bot');

            try {
                var res = await fetch('/api/ChatApi', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text })
                });
                var data = await res.json();
                loading.remove();
                appendMessage(data.reply || 'No pude responder ahora 😅', 'sg-msg-bot');
            } catch (e) {
                loading.remove();
                appendMessage('Ocurrió un error. Intenta de nuevo.', 'sg-msg-bot');
            }

            input.disabled = false;
            sendBtn.disabled = false;
            input.focus();
        }

        sendBtn.addEventListener('click', sendMessage);
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') sendMessage();
        });

        // Sugerencias: al hacer clic se envía como mensaje del usuario
        var suggestions = document.getElementById('sg-suggestions');
        if (suggestions) {
            suggestions.querySelectorAll('.sg-suggestion-btn').forEach(function (sbtn) {
                sbtn.addEventListener('click', function () {
                    input.value = sbtn.textContent.trim();
                    suggestions.style.display = 'none';
                    sendMessage();
                });
            });
        }

        // Ocultar sugerencias en cuanto el usuario empieza a escribir
        input.addEventListener('input', function () {
            if (suggestions && input.value.trim().length > 0) {
                suggestions.style.display = 'none';
            }
        });
    })();
    </script>

</body>
</html>
