@model DkaizaProject.Models.Cliente

<div class="auth-page">

    <div class="auth-card auth-card-wide">

        <div class="auth-header">

            <h1>Registrar cliente</h1>

            <p>
                Ingrese los datos del nuevo cliente
            </p>

        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="toast-custom toast-success">
                @TempData["Mensaje"]
            </div>
        }

        <form asp-action="Create"
              method="post"
              class="auth-form">

            <div asp-validation-summary="ModelOnly"
                 class="alert-error">
            </div>

            <div class="form-row-2">

                <div class="form-field">

                    <label>Nombre</label>

                    <input asp-for="Nombre" />

                    <span asp-validation-for="Nombre"
                          class="field-error"></span>

                </div>

                <div class="form-field">

                    <label>Apellido</label>

                    <input asp-for="Apellido" />

                    <span asp-validation-for="Apellido"
                          class="field-error"></span>

                </div>

            </div>

            <div class="form-field">

                <label>Email</label>

                <input asp-for="Email" />

                <span asp-validation-for="Email"
                      class="field-error"></span>

            </div>

            <div class="form-field">

                <label>Telefono</label>

                <input asp-for="Telefono" />

                <span asp-validation-for="Telefono"
                      class="field-error"></span>

            </div>

            <button type="submit"
                    class="btn-auth">

                Guardar cliente

            </button>

        </form>

    </div>

</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}