@model IEnumerable<DkaizaProject.Models.Cliente>

<style>
    .admin-table tr.clickable { cursor: pointer; transition: background 0.15s; }
    .admin-table tr.clickable:hover td { background: var(--rose-light); }
    .admin-table tr.clickable td:last-child { color: var(--rose-dark); font-size: 0.78rem; opacity: 0; transition: opacity 0.15s; text-align: right; }
    .admin-table tr.clickable:hover td:last-child { opacity: 1; }
    .hint-bar { background: var(--cream); border-left: 3px solid var(--rose); padding: 10px 14px; border-radius: 8px; margin-bottom: 1rem; font-size: 0.85rem; color: var(--ink-mid); }
    .empty-row td { text-align: center; padding: 2rem; color: var(--ink-light); font-style: italic; }
</style>

<div class="admin-page">

    <div class="container">

        <div class="page-header">

            <div>

                <p class="section-eyebrow">
                    CLIENTES
                </p>

                <h1>
                    Clientes registrados
                </h1>

            </div>

        </div>

        <div class="hint-bar">
            <i class="fas fa-info-circle"></i> Seleccione un cliente para registrar un servicio y procesar su pago.
        </div>

        <div class="admin-table-wrap">

            <table class="admin-table">

                <thead>

                    <tr>
                        <th>Nombre completo</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th style="width: 180px;"></th>
                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr class="empty-row"><td colspan="4">No hay clientes registrados todavía.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="clickable" onclick="window.location.href='/Clientes/RegistrarServicio/@item.Id'">

                                <td>
                                    @item.NombreCompleto
                                </td>

                                <td>
                                    @item.Email
                                </td>

                                <td>
                                    @item.Telefono
                                </td>

                                <td>
                                    <i class="fas fa-arrow-right"></i> Registrar servicio
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>