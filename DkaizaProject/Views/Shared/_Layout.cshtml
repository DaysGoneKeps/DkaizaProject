<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Salón Belleza</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)
</head>
<body>

<nav class="navbar">
    <div class="nav-inner">
        <a class="nav-brand" href="/"> D'Kaiza</a>
        <div class="nav-links">
            <a href="/">Inicio</a>
            @if (Context.Session.GetInt32("ClienteId") != null)
            {
                <a href="/Appointments/Reservar" class="btn-nav-primary">Reservar</a>
                <a href="/Appointments/MisCitas">Mis citas</a>
                @if (Context.Session.GetString("EsAdmin") == "True")
                {
                    <a href="/Admin">Admin</a>
                }
                <div class="nav-user">
                    <span>@Context.Session.GetString("ClienteNombre")</span>
                    <a href="/Account/Logout" class="nav-logout">Salir</a>
                </div>
            }
            else
            {
                <a href="/Account/Login">Ingresar</a>
                <a href="/Account/Register" class="btn-nav-primary">Registrarse</a>
            }
        </div>
    </div>
</nav>

@if (TempData["Success"] != null)
{
    <div class="toast toast-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="toast toast-error">@TempData["Error"]</div>
}

<main>
    @RenderBody()
</main>

<footer class="footer">
    <div class="footer-inner">
        <span class="footer-brand">Salon Belleza</span>
        <span>© @DateTime.Now.Year · Todos los derechos reservados</span>
    </div>
</footer>

<script src="~/js/site.js"></script>
@RenderSection("Scripts", required: false)

</body>
</html>