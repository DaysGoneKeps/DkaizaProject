@model List<DkaizaProject.Models.Servicio>
@{
    ViewData["Title"] = "Nuestros Servicios - D'KAIZA";
    Layout = "_Layout";
}

<style>
    .services-hero {
        background: linear-gradient(135deg, var(--cream) 0%, var(--rose-light) 100%);
        padding: 3rem 0 4rem;
        position: relative;
        overflow: hidden;
        text-align: center;
    }
    
    .services-hero::before {
        content: '✂';
        position: absolute;
        bottom: -30px;
        right: -30px;
        font-size: 200px;
        opacity: 0.05;
        font-family: var(--font-display);
    }
    
    .services-hero::after {
        content: '✦';
        position: absolute;
        top: -20px;
        left: -20px;
        font-size: 150px;
        opacity: 0.05;
        font-family: var(--font-display);
    }
    
    .services-eyebrow {
        font-size: 12px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--rose);
        font-weight: 600;
        margin-bottom: 1rem;
    }
    
    .services-title {
        font-family: var(--font-display);
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 0.5rem;
    }
    
    .services-subtitle {
        color: var(--ink-light);
        font-size: 1rem;
        max-width: 500px;
        margin: 0 auto;
    }
    
    /* Filtros */
    .filters-section {
        padding: 1.5rem 0;
        background: var(--white);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 70px;
        z-index: 90;
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(10px);
    }
    
    .filter-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 20px;
        border-radius: 50px;
        background: var(--cream-dark);
        color: var(--ink-mid);
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.3s ease;
        border: 1px solid transparent;
    }
    
    .filter-badge:hover {
        background: var(--rose-light);
        color: var(--rose-dark);
    }
    
    .filter-badge.active {
        background: var(--ink);
        color: white;
    }
    
    .services-section {
        padding: 3rem 0 5rem;
        background: var(--white);
    }
    
    /* Botón flotante de volver */
    .back-home-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: var(--ink);
        color: white;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
        z-index: 100;
        text-decoration: none;
    }
    
    .back-home-btn:hover {
        background: var(--rose-dark);
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.25);
        color: white;
    }
    
    /* Resto de estilos de tarjetas (mantener los que ya tenías) */
    .service-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: all 0.35s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }
    
    .service-card:hover {
        transform: translateY(-6px);
        border-color: var(--rose);
        box-shadow: 0 20px 30px -12px rgba(0,0,0,0.1);
    }
    
    .service-image {
        background: linear-gradient(135deg, var(--rose-light) 0%, var(--cream-dark) 100%);
        padding: 1.5rem;
        text-align: center;
        position: relative;
        transition: all 0.3s ease;
    }
    
    .service-card:hover .service-image {
        background: linear-gradient(135deg, var(--rose) 0%, var(--rose-dark) 100%);
    }
    
    .service-image i {
        font-size: 3rem;
        color: var(--rose-dark);
        transition: all 0.3s ease;
    }
    
    .service-card:hover .service-image i {
        color: white;
        transform: scale(1.1);
    }
    
    .service-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: linear-gradient(135deg, var(--rose), var(--soft-sandstone));
        color: white;
        font-size: 0.65rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 20px;
    }
    
    .service-content {
        padding: 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    
    .service-name {
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 0.5rem;
    }
    
    .service-description {
        font-size: 0.8rem;
        color: var(--ink-light);
        line-height: 1.5;
        margin-bottom: 1rem;
    }
    
    .service-details {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s ease-out;
        background: var(--cream);
        border-radius: var(--radius-sm);
        margin-top: 0;
    }
    
    .service-card.expanded .service-details {
        max-height: 150px;
        margin-top: 1rem;
    }
    
    .service-details-inner {
        padding: 0.75rem;
    }
    
    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
    }
    
    .detail-label {
        font-size: 0.75rem;
        color: var(--ink-light);
        display: flex;
        align-items: center;
        gap: 5px;
    }
    
    .detail-label i {
        color: var(--rose);
        font-size: 0.7rem;
    }
    
    .detail-value {
        font-weight: 600;
        color: var(--ink);
        font-size: 0.85rem;
    }
    
    .service-price {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--rose-dark);
    }
    
    .btn-expand {
        width: 100%;
        background: transparent;
        border: 1px solid var(--border-mid);
        border-radius: 50px;
        padding: 8px;
        margin-top: 1rem;
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--ink-mid);
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    
    .btn-expand:hover {
        background: var(--rose-light);
        border-color: var(--rose);
        color: var(--rose);
    }
    
    .btn-expand i {
        transition: transform 0.3s ease;
    }
    
    .service-card.expanded .btn-expand i {
        transform: rotate(180deg);
    }
    
    .btn-reserve-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--ink);
        color: white !important;
        border: none;
        border-radius: 50px;
        padding: 10px 16px;
        margin-top: 1rem;
        font-size: 0.8rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
    }
    
    .btn-reserve-card:hover {
        background: var(--rose-dark);
        transform: translateY(-2px);
    }
    
    .results-count {
        font-size: 0.85rem;
        color: var(--ink-light);
        margin-bottom: 1.5rem;
    }
    
    .results-count strong {
        color: var(--rose-dark);
        font-size: 1rem;
    }
    
    .service-col.hidden {
        display: none;
    }
    
    @@media (max-width: 768px) {
        .back-home-btn {
            bottom: 20px;
            right: 20px;
            width: 45px;
            height: 45px;
        }
        
        .service-image i {
            font-size: 2.5rem;
        }
    }
</style>

<!-- Hero sin botón de volver -->
<div class="services-hero">
    <div class="container">
        <p class="services-eyebrow">Elige tu favorito</p>
        <h1 class="services-title">Nuestros Servicios</h1>
        <p class="services-subtitle">Selecciona, conoce los detalles y reserva</p>
    </div>
</div>

<!-- Filtros -->
<div class="filters-section">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <div class="filter-badge active" data-filter="all">
                <i class="fas fa-border-all"></i> Todos
            </div>
            <div class="filter-badge" data-filter="1h">
                <i class="far fa-clock"></i> 1 hora
            </div>
            <div class="filter-badge" data-filter="2h">
                <i class="far fa-clock"></i> 2 horas
            </div>
            <div class="filter-badge" data-filter="3h">
                <i class="far fa-clock"></i> 3+ horas
            </div>
        </div>
    </div>
</div>

<!-- Grid de servicios -->
<section class="services-section">
    <div class="container">
        <div class="results-count">
            <i class="fas fa-spa"></i> <strong id="resultCount">0</strong> servicios disponibles
        </div>
        
        <div class="row g-4" id="servicesGrid">
            @foreach (var svc in Model)
            {
                <div class="col-lg-4 col-md-6 service-col" data-duration="@svc.DuracionHoras">
                    <div class="service-card" data-service-id="@svc.Id">
                        <div class="service-image">
                            <i class="fas @GetServiceIcon(svc.Nombre, svc.DuracionHoras)"></i>
                            @if (svc.DuracionHoras >= 2)
                            {
                                <span class="service-badge">⭐ Popular</span>
                            }
                        </div>
                        <div class="service-content">
                            <h3 class="service-name">@svc.Nombre</h3>
                            <p class="service-description">@(svc.Descripcion ?? "Servicio profesional con los mejores productos")</p>
                            
                            <div class="service-details">
                                <div class="service-details-inner">
                                    <div class="detail-row">
                                        <span class="detail-label">
                                            <i class="far fa-clock"></i> Duración
                                        </span>
                                        <span class="detail-value">@svc.DuracionHoras hora@(svc.DuracionHoras > 1 ? "s" : "")</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">
                                            <i class="fas fa-tag"></i> Precio
                                        </span>
                                        <span class="detail-value service-price">S/ @svc.Precio.ToString("0")</span>
                                    </div>
                                </div>
                            </div>
                            
                            <button class="btn-expand" onclick="toggleService(this)">
                                <span>Ver detalles</span>
                                <i class="fas fa-chevron-down"></i>
                            </button>
                            
                            <button onclick="reservarServicio(@svc.Id)" class="btn-reserve-card">
                                <span>Reservar ahora</span>
                                <i class="fas fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-cut"></i>
                <h3>No hay servicios disponibles</h3>
                <p>Pronto añadiremos nuestros servicios. ¡Vuelve pronto!</p>
                <a href="/" class="btn-primary-lg" style="margin-top: 1rem; display: inline-block;">
                    <i class="fas fa-home"></i> Volver al inicio
                </a>
            </div>
        }
    </div>
</section>

<!-- Botón flotante Volver al inicio -->
<a href="/" class="back-home-btn" title="Volver al inicio">
    <i class="fas fa-home"></i>
</a>

<script>
    function toggleService(btn) {
        const serviceCard = btn.closest('.service-card');
        const expandText = btn.querySelector('span');
        const icon = btn.querySelector('i');
        
        serviceCard.classList.toggle('expanded');
        
        if (serviceCard.classList.contains('expanded')) {
            expandText.textContent = 'Ver menos';
            icon.style.transform = 'rotate(180deg)';
        } else {
            expandText.textContent = 'Ver detalles';
            icon.style.transform = 'rotate(0deg)';
        }
    }
    
    function reservarServicio(servicioId) {
        window.location.href = '/Appointments/Reservar?servicioId=' + servicioId;
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        const filterBadges = document.querySelectorAll('.filter-badge');
        const serviceCols = document.querySelectorAll('.service-col');
        const resultCountSpan = document.getElementById('resultCount');
        
        function updateResultCount() {
            const visibleCount = document.querySelectorAll('.service-col:not(.hidden)').length;
            if (resultCountSpan) resultCountSpan.textContent = visibleCount;
        }
        
        filterBadges.forEach(badge => {
            badge.addEventListener('click', function() {
                filterBadges.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                
                const filter = this.dataset.filter;
                
                serviceCols.forEach(col => {
                    const duration = parseInt(col.dataset.duration);
                    
                    if (filter === 'all') {
                        col.classList.remove('hidden');
                    } else if (filter === '1h' && duration === 1) {
                        col.classList.remove('hidden');
                    } else if (filter === '2h' && duration === 2) {
                        col.classList.remove('hidden');
                    } else if (filter === '3h' && duration >= 3) {
                        col.classList.remove('hidden');
                    } else {
                        col.classList.add('hidden');
                    }
                });
                
                updateResultCount();
            });
        });
        
        updateResultCount();
    });
</script>

@functions {
    private string GetServiceIcon(string nombre, int duracion)
    {
        var nombreLower = nombre?.ToLower() ?? "";
        
        if (nombreLower.Contains("corte")) return "fa-cut";
        if (nombreLower.Contains("tinte") || nombreLower.Contains("color")) return "fa-palette";
        if (nombreLower.Contains("peinado") || nombreLower.Contains("lavado")) return "fa-hand-sparkles";
        if (nombreLower.Contains("alisado") || nombreLower.Contains("keratina")) return "fa-feather-alt";
        if (nombreLower.Contains("tratamiento")) return "fa-spa";
        
        if (duracion == 1) return "fa-cut";
        if (duracion == 2) return "fa-spa";
        if (duracion >= 3) return "fa-crown";
        
        return "fa-star";
    }
}